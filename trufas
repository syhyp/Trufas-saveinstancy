	local function recordRemote(remote, direction, method, ...)
		if RemoteLogCount >= OPTIONS.RemoteLogLimit then
			return
		end
		local okName, path = pcall(remote.GetFullName, remote)
		if not okName then
			return
		end
		local entry = RemoteLogData[path]
		if not entry then
			entry = { Class = remote.ClassName, Out = {}, In = {} }
			RemoteLogData[path] = entry
			Stats.remotes += 1
		end
		local count = select("#", ...)
		local types = table.create(count)
		for i = 1, count do
			types[i] = typeof((select(i, ...)))
		end
		local signature = table.concat(types, ", ")
		local bucket = direction == "out" and entry.Out or entry.In
		local record = bucket[signature]
		if not record then
			record = { Signature = signature, Count = 0, Method = method, Sample = "" }
			local sample = table.pack(...)
			local okSample, literal = pcall(function()
				local items = {}
				for i = 1, math.min(sample.n, 8) do
					items[i] = luaLiteral(sample[i], 1, nil, { n = 200 })
				end
				return table.concat(items, ", ")
			end)
			if okSample then
				record.Sample = literal
			end
			bucket[signature] = record
		end
		record.Count += 1
		RemoteLogCount += 1
	end

