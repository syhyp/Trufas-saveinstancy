	local diskCacheEnabled = OPTIONS.DecompileCache and OPTIONS.Decompile and (getscripthash or getscriptbytecode) and readfile and writefile and isfile and true or false
	local diskCache, diskCacheAll, diskCacheDirty, diskCacheSize = {}, {}, false, 0
	local decompiledSinceFlush = 0

	local function evictDiskCache(targetFraction)
		local target = DISK_CACHE_LIMIT * targetFraction
		if diskCacheSize <= target then
			return
		end
		local list = {}
		for hash, entry in diskCache do
			list[#list + 1] = { hash, entry.u or 0 }
		end
		table.sort(list, function(a, b)
			return a[2] < b[2]
		end)
		for _, item in list do
			if diskCacheSize <= target then
				break
			end
			local entry = diskCache[item[1]]
			diskCacheSize -= #entry.o
			diskCache[item[1]] = nil
			diskCacheDirty = true
		end
	end

	if diskCacheEnabled and isfile(DISK_CACHE_FILE) then
		local ok, decoded = pcall(function()
			return service.HttpService:JSONDecode(readfile(DISK_CACHE_FILE))
		end)
		if ok and type(decoded) == "table" then
			local prefix = EXECUTOR_NAME .. "@"
			for key, entries in decoded do
				if key == DISK_CACHE_KEY then
					continue
				end
				if type(entries) == "table" and not (EXECUTOR_NAME ~= "" and string.sub(key, 1, #prefix) == prefix) then
					diskCacheAll[key] = entries
				else
					diskCacheDirty = true
				end
			end
			local current = decoded[DISK_CACHE_KEY]
			if type(current) == "table" then
				local now = os.time()
				for hash, entry in current do
					if type(entry) == "table" and type(entry.o) == "string" and now - (entry.u or 0) <= DISK_CACHE_TTL then
						if entry.v == nil or entry.v == FULL_VERSION then
