            end,
            [2]=function()
                local csv=tostring(CLIENT_VERSION); local dump
                local mvs,matched,is_matched,exact_match={},{}
                local function process_line(line,ni)
                    local fv,pc,vh=string.match(line,'"%d+%.(%d+)%.([^"]+)": "(version%-[^"]+)')
                    if fv==csv then
                        is_matched=true
                        if vh and not matched[vh] then
                            matched[vh]=true
                            if not ni then table.insert(mvs,vh) end
                            if string.sub(FULL_VERSION,-#pc)==pc then return vh end
                        end
                    elseif is_matched then return false end
                end
                local function isFullDump(classes)
                    for _,c in classes do
                        for _,m in c.Members do
                            if m.MemberType=="Property" then return m.Default~=nil end
                        end
                    end
                    return false
                end
                local function tryFetchDump(url)
                    local ok,dec=pcall(function() return service.HttpService:JSONDecode(game:HttpGet(url,true)) end)
                    return ok and dec.Classes or nil
                end
                local function fetchFullApiDump(hash)
                    local dec=tryFetchDump("https://setup.rbxcdn.com/"..hash.."-Full-API-Dump.json")
                    if dec and isFullDump(dec) then return dec end
                    dec=tryFetchDump("https://raw.githubusercontent.com/setup-rbxcdn/roblox-full-api-dumps/refs/heads/main/full-dumps/"..hash.."-Full-API-Dump.json")
                    if dec and isFullDump(dec) then return dec end
                    return nil
                end
                do
                    local o,r=pcall(game.HttpGet,game,"https://raw.githubusercontent.com/setup-rbxcdn/setup-rbxcdn.github.io/refs/heads/main/version-history/Windows/Studio64.json",true)
                    if o then
                        local vh=string.split(r,"\n"); vh[#vh]=nil
                        for i=#vh,2,-1 do
                            local res=process_line(vh[i])
                            if res==false then break elseif res then exact_match=res end
                        end
                    end
                end
                do
                    local function fb(ch)
                        local ok,res=pcall(function()
                            return service.HttpService:JSONDecode(game:HttpGet("https://clientsettingscdn.roblox.com/v2/client-version/WindowsStudio64"..(ch and "/channel/"..ch or ""),true))
                        end)
                        if not ok then return end
                        if res.version and res.clientVersionUpload then
                            return process_line('"'..res.version..'": "'..res.clientVersionUpload,true)
                        end
                    end
                    if not exact_match then exact_match=fb("zbeta") or fb() end
                end
                if exact_match then dump=fetchFullApiDump(exact_match) end
                if not dump then
                    for _,vh in mvs do dump=fetchFullApiDump(vh); if dump then break end end
                end
                return dump
            end,
            [3]=function()
                local classes,cs={},1
                for _,ac in service.ReflectionService:GetClasses(filter) do
                    local members,ms={},1; local cn=ac.Name
                    local class={Name=cn,Members=members,Superclass=ac.Superclass or "<<<ROOT>>>"}
                    local permits=ac.Permits; local tags={}
                    if ac.Service then table.insert(tags,"Service")
                    elseif permits and permits["GetService"] then table.insert(tags,"Service")
                    elseif not permits or not permits["New"] then table.insert(tags,"NotCreatable") end
                    if #tags~=0 then class.Tags=tags end
                    local o,r=pcall(service.ReflectionService.GetPropertiesOfClass,service.ReflectionService,cn,filter)
                    if o then
                        for _,prop in r do
                            local pn=prop.Name; local vt=prop.Type; local vtn=vt.EngineType
                            local cat=vt.Category; local mt={}
                            if not next(prop.Permits) then table.insert(mt,"NotScriptable") end
                            if vtn=="Enum" then cat,vtn="Enum",vt.EnumType
                            elseif vtn=="RefType" then cat,vtn="Class",vt.InstanceType
                            else
                                local rn={CoordinateFrame="CFrame",Rect2D="Rect",Vector3Int16="Vector3int16",Vector2Int16="Vector2int16",Region3Int16="Region3int16"}
                                vtn=rn[vtn] or vtn
                            end
                            local member={Name=pn,MemberType="Property",ValueType={Name=vtn,Category=cat},Serialization={CanLoad=prop.Serialized,CanSave=prop.Serialized}}
                            if #mt~=0 then member.Tags=mt end
                            members[ms]=member; ms+=1
                        end
                    end
                    classes[cs]=class; cs+=1
                end
                return classes
            end,
            [4]=function()
                return service.HttpService:JSONDecode(game:HttpGet("https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/roblox/Mini-API-Dump.json",true)).Classes
            end,
        }

        for i,fetcher in APIDUMP_FETCHERS do
            local o,r=pcall(fetcher)
            if o and r then
                API_Dump=r
                if i==2 and writefile then
                    pcall(writefile,FILE_NAME,service.HttpService:JSONEncode({[FULL_VERSION]=API_Dump}))
                end
                break
            elseif r~=false and 2<i then
                warn("[DEBUG] Failed API Dump method",i,":",r)
            end
        end

        local classList={}; local tcd={}
        local CW,CB=ClassPropertyExceptions.Whitelist,ClassPropertyExceptions.Blacklist

        for _,AC in API_Dump do
            local CN=AC.Name; local props={}
            for _,M in AC.Members do
                local mt=M.MemberType
                if mt=="Property" or mt=="Function" then
                    props[M.Name]={ValueType=mt=="Property" and M.ValueType.Name,MemberType=mt}
                end
            end
            tcd[CN]=props
        end

        for _,AC in API_Dump do
            local CP,CPS={},1
            local Class={Properties=CP,Superclass=AC.Superclass,NotCreatable=nil}
            local CN=AC.Name; local CT=AC.Tags
            if CT then
                local Tags=arrayToDict(CT,nil,nil,"string")
