				table.insert(lines, "for _, v in game:GetDescendants() do if v:IsA('TriangleMeshPart') then v.CollisionFidelity = Enum.CollisionFidelity.Default end end")
				table.insert(lines, "")
				table.insert(lines, "Se nao conseguir mover a camera: workspace.CurrentCamera.CameraType = Enum.CameraType.Fixed")
				table.insert(lines, "")
				table.insert(lines, "Compressao: " .. compressionUsed)
				if #AttemptLog > 0 then
					table.insert(lines, "Tentativas: " .. table.concat(AttemptLog, " -> "))
				end
				table.insert(lines, "Configuracoes: " .. optionsSummary())
				table.insert(lines, "Tempo: " .. ELAPSED_PLACEHOLDER)
				table.insert(lines, "Executor: " .. (EXECUTOR_NAME ~= "" and (EXECUTOR_NAME .. " " .. EXECUTOR_VERSION) or "Desconhecido"))
				table.insert(lines, "Cliente: " .. FULL_VERSION .. " | PlaceId: " .. tostring(game.PlaceId) .. " | PlaceVersion: " .. tostring(game.PlaceVersion))
				local body = string.gsub(table.concat(lines, "\n\t\t"), "%]%]", "] ]")
				return "--[[\n\t\t" .. body .. "\n]]"
			end, true)
		end

		local function gatherRoots()
			local allRoots = table.clone(ToSaveList)
			for _, extra in pendingExtras do
				for _, root in extra.roots do
					allRoots[#allRoots + 1] = root
				end
			end
			return allRoots
		end

		local estimate = 0
		if StatusText then
			for _, root in ToSaveList do
				estimate += #root:GetDescendants() + 1
			end
		end

		local function buildOutput()
			totalsize = 0
			table.clear(DroppedLog)
			resetSharedStrings()
			resetBuildStats()
			setPhase("Coletando", estimate)

			local ctx = collect(gatherRoots())

			for _, extra in pendingExtras do
				local src = extra.roots
				local kept = table.create(#src)
				for _, root in src do
					if ctx.entries[root] then
						kept[#kept + 1] = root
					end
				end
				extra.collectedRoots = kept
				if extra.defer then
					for _, root in kept do
						ctx.entries[root].deferLast = true
					end
				end
			end

			for node in deferredNodes do
				local nodeEntry = ctx.entries[node]
				if nodeEntry then
					nodeEntry.deferLast = true
				end
			end

			local claimed = {}
			for _, extra in pendingExtras do
				for _, root in extra.collectedRoots do
					claimed[root] = true
					local rootEntry = ctx.entries[root]
					local isVirtual = rootEntry and rootEntry.virtual
					local toDetach = isVirtual and table.clone(rootEntry.children) or { root }
					for _, node in toDetach do
						local e = ctx.entries[node]
						local old = e.parent and ctx.entries[e.parent]
						if e.parent ~= root then
							if old then
								local kids = old.children
								for i = #kids, 1, -1 do
									if kids[i] == node then
										table.remove(kids, i)
										break
									end
								end
							end
							e.parent = isVirtual and root or nil
						end
					end
				end
			end

			local mainRoots = table.create(#ctx.roots)
			for _, root in ctx.roots do
				if not claimed[root] then
					mainRoots[#mainRoots + 1] = root
				end
			end
			ctx.mainRoots = mainRoots

			Stats.instances = ctx.instCount
			exportEditables(ctx)

			setPhase(OPTIONS.Binary and "Codificando" or "Salvando", ctx.instCount)

			local chunks = OPTIONS.Binary and emitBinary(ctx) or emitXML(ctx)

			if OPTIONS.ReadMe then
				stampElapsed(chunks, os.clock() - elapse_t)
			end
			return chunks, ctx
		end

		local externalPassCount = 0
		local function buildWithExternals()
			local chunks, ctx = buildOutput()
			while OPTIONS.ExternalContentPass and OPTIONS.Binary and externalPassCount < 3 and next(ExternalContentPending) do
				externalPassCount += 1
				local list = {}
				for object in ExternalContentPending do
					if typeof(object) == "Instance" then
						list[#list + 1] = object
					end
				end
				table.clear(ExternalContentPending)
				if #list == 0 then
					break
				end
				register_extra("External Content " .. externalPassCount, list)
				chunks, ctx = buildOutput()
				Stats.externalContent += #list
				Stats.contentPasses = externalPassCount
			end
			return chunks, ctx
		end

		local writesFile = not (CopyToClipboard or Callback)
		local attempts = {
			{ label = "padrao", setup = function() end },
		}
		if OPTIONS.AutoRetry and OPTIONS.Validate and writesFile then
			table.insert(attempts, {
				label = "sem propriedades especiais",
				setup = function()
					if gethiddenproperty and not old_gethiddenproperty then
						old_gethiddenproperty = gethiddenproperty
					end
					gethiddenproperty = nil
				end,
			})
			if OPTIONS.Binary then
				table.insert(attempts, {
					label = "XML sem compressao",
					setup = function()
						OPTIONS.Binary = false
						compressionUsed = "nenhuma"
						local ext = string.sub(placename, -5)
						if ext == ".rbxl" or ext == ".rbxm" then
							placename ..= "x"
						end
					end,
				})
			end
		end

		local finalChunks, finalProblem, lastError
		for idx, attempt in attempts do
			attempt.setup()
			if idx > 1 then
				warn("[USSI] Retry " .. (idx - 1) .. ": " .. attempt.label)
			end
			local ok, chunks, ctx = xpcall(buildWithExternals, function(e)
				return debug.traceback(tostring(e))
			end)
			local problem
			if not ok then
				problem = "erro durante a geracao: " .. tostring(chunks)
				chunks = nil
			else
				problem = validateOutput(chunks, ctx)
			end
			table.insert(AttemptLog, attempt.label .. ": " .. (problem and "FALHOU" or "ok"))
			if not problem then
				finalChunks, finalProblem = chunks, nil
				break
			end
			warn("[USSI] Validacao falhou (" .. attempt.label .. "):", problem)
			lastError = problem
			if idx == #attempts then
				if chunks then
					finalChunks, finalProblem = chunks, problem
				end
			end
		end

		if not finalChunks then
			error(lastError or "falha desconhecida ao gerar o arquivo")
		end
		if finalProblem then
			validationNote = " | AVISO: " .. finalProblem
		elseif OPTIONS.Validate then
			validationNote = " | Validado" .. (#AttemptLog > 1 and (" (tentativa " .. #AttemptLog .. ")") or "")
		end

		processAssets()

		phase = "Escrevendo"

		local function writeChunks()
			if CopyToClipboard then
				if setrbxclipboard then
					setrbxclipboard(table.concat(finalChunks))
				else
					warn("setrbxclipboard indisponivel")
				end
			elseif Callback then
				Callback(table.concat(finalChunks), finalChunks)
			elseif OPTIONS.AlternativeWritefile and appendfile then
				local SEGMENT_SIZE = 4145728
				local batch, batchSize, written = {}, 0, 0
				local function flush()
					if batchSize == 0 then
						return
					end
					written += batchSize
					run_with_loading(
						"Escrevendo " .. math.round(written / math.max(totalsize, 1) * 100) .. "%",
						nil,
						false,
						appendfile,
						placename,
						table.concat(batch)
					)
					table.clear(batch)
					batchSize = 0
					task.wait()
				end
				writefile(placename, "")
				for _, chunk in finalChunks do
					if #chunk >= SEGMENT_SIZE then
						flush()
						local offset = 1
						while offset <= #chunk do
							appendfile(placename, string.sub(chunk, offset, offset + SEGMENT_SIZE - 1))
							offset += SEGMENT_SIZE
							task.wait()
						end
						written += #chunk
					else
						batch[#batch + 1] = chunk
						batchSize += #chunk
						if batchSize >= SEGMENT_SIZE then
							flush()
						end
					end
				end
				flush()
			elseif writefile then
				run_with_loading("Escrevendo " .. get_size_format() .. " no arquivo", nil, true, writefile, placename, table.concat(finalChunks))
			end
		end

		local function verifyOnDisk()
			if not OPTIONS.Validate or not isfile then
				return nil
			end
			if not isfile(placename) then
				return "arquivo nao encontrado"
			end
			local expected = 0
			for _, chunk in finalChunks do
				expected += #chunk
			end
			if expected <= 48 * 1024 * 1024 and readfile then
				local ok, data = pcall(readfile, placename)
				if ok and type(data) == "string" then
					if #data ~= expected then
						return "tamanho em disco (" .. #data .. ") diferente do esperado (" .. expected .. ")"
					end
					if string.sub(data, -9) ~= string.sub(finalChunks[#finalChunks], -9) then
						return "final do arquivo divergente"
					end
				end
			else
				validationNote ..= " | tamanho nao verificado (arquivo grande)"
			end
			return nil
		end

		local function removeBadFile()
			if OPTIONS.DeleteInvalidFile and delfile and isfile and isfile(placename) then
				pcall(delfile, placename)
			end
		end

		for try = 1, writesFile and 2 or 1 do
			writeChunks()
			if not writesFile then
				break
			end
			local diskProblem = verifyOnDisk()
			if not diskProblem then
				break
			end
			warn("[USSI] Verificacao em disco falhou (tentativa " .. try .. "):", diskProblem)
			removeBadFile()
			if try == 2 then
				validationNote = " | ERRO: " .. diskProblem
				error("arquivo gravado de forma invalida: " .. diskProblem)
			end
			task.wait(0.5)
		end
	end

