local function luaNumber(n)
	if n ~= n then
		return "(0/0)"
	elseif n == math.huge then
		return "math.huge"
	elseif n == -math.huge then
		return "-math.huge"
	elseif n == math.floor(n) and math.abs(n) < 1e15 then
		return string.format("%d", n)
	end
	return string.format("%.9g", n)
end

local function luaCall(name, ...)
	local parts = table.pack(...)
	for i = 1, parts.n do
		parts[i] = luaNumber(parts[i])
	end
	return name .. "(" .. table.concat(parts, ", ") .. ")"
end

local function sanitizeComment(s)
	local r = string.gsub(tostring(s), "[%]%[\n\r]", "_")
	return r
end

local luaLiteral
luaLiteral = function(value, depth, seen, budget)
	depth = depth or 0
	seen = seen or {}
	budget = budget or { n = 5000 }
	budget.n -= 1
	if budget.n <= 0 then
		return "nil"
	end
	local t = typeof(value)
	if t == "string" then
		return string.format("%q", value)
	elseif t == "number" then
		return luaNumber(value)
	elseif t == "boolean" or t == "nil" then
		return tostring(value)
	elseif t == "Vector3" then
		return luaCall("Vector3.new", value.X, value.Y, value.Z)
	elseif t == "Vector2" then
		return luaCall("Vector2.new", value.X, value.Y)
	elseif t == "Color3" then
		return luaCall("Color3.new", value.R, value.G, value.B)
	elseif t == "UDim" then
		return luaCall("UDim.new", value.Scale, value.Offset)
	elseif t == "UDim2" then
		return luaCall("UDim2.new", value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset)
	elseif t == "CFrame" then
		return luaCall("CFrame.new", value:GetComponents())
	elseif t == "EnumItem" then
		return tostring(value)
	elseif t == "BrickColor" then
		return luaCall("BrickColor.new", value.Number)
	elseif t == "NumberRange" then
		return luaCall("NumberRange.new", value.Min, value.Max)
	elseif t == "Instance" then
		local ok, fullName = pcall(value.GetFullName, value)
		return "nil --[[" .. sanitizeComment(ok and fullName or "Instance") .. "]]"
	elseif t == "table" then
		if seen[value] or depth > 8 then
			return "nil"
		end
		seen[value] = true
		local keys = {}
		pcall(function()
			for k in next, value do
				local tk = type(k)
				if tk == "string" or tk == "number" then
					keys[#keys + 1] = k
				end
			end
		end)
		table.sort(keys, function(a, b)
			local ta, tb = type(a), type(b)
			if ta ~= tb then
				return ta == "number"
			end
			return a < b
		end)
		local isArray = true
		for i, k in keys do
			if k ~= i then
				isArray = false
				break
			end
		end
		local pad = string.rep("\t", depth + 1)
		local lines = {}
		for _, k in keys do
			local item = luaLiteral(rawget(value, k), depth + 1, seen, budget)
			if isArray then
				lines[#lines + 1] = pad .. item
			else
				local keyText
				if type(k) == "number" then
					keyText = "[" .. luaNumber(k) .. "]"
				elseif not LUA_KEYWORDS[k] and string.match(k, "^[%a_][%w_]*$") then
					keyText = k
				else
					keyText = "[" .. string.format("%q", k) .. "]"
				end
				lines[#lines + 1] = pad .. keyText .. " = " .. item
			end
		end
		seen[value] = nil
		if #lines == 0 then
			return "{}"
		end
		return "{\n" .. table.concat(lines, ",\n") .. ",\n" .. string.rep("\t", depth) .. "}"
	end
	return "nil"
end

local CRC_TABLE = {}
for i = 0, 255 do
	local c = i
	for _ = 1, 8 do
		if bit32.band(c, 1) == 1 then
			c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
		else
			c = bit32.rshift(c, 1)
		end
	end
	CRC_TABLE[i] = c
end

local function crc32Buffer(b, offset, length)
	local crc = 0xFFFFFFFF
	local rshift, bxor, band = bit32.rshift, bit32.bxor, bit32.band
	local ru8 = buffer.readu8
	for i = offset, offset + length - 1 do
		crc = bxor(CRC_TABLE[band(bxor(crc, ru8(b, i)), 0xFF)], rshift(crc, 8))
	end
	return bxor(crc, 0xFFFFFFFF)
end

local function writeBE32(b, offset, v)
	buffer.writeu8(b, offset, bit32.rshift(v, 24))
	buffer.writeu8(b, offset + 1, bit32.band(bit32.rshift(v, 16), 0xFF))
	buffer.writeu8(b, offset + 2, bit32.band(bit32.rshift(v, 8), 0xFF))
	buffer.writeu8(b, offset + 3, bit32.band(v, 0xFF))
end

local function pngChunk(typeAndData)
	local len = buffer.len(typeAndData) - 4
	local out = buffer.create(len + 12)
	writeBE32(out, 0, len)
	buffer.copy(out, 4, typeAndData)
	writeBE32(out, len + 8, crc32Buffer(typeAndData, 0, len + 4))
	return buffer.tostring(out)
end

local function encodePNG(width, height, pixels)
	local rowLen = width * 4
	local rawLen = (rowLen + 1) * height
	local raw = buffer.create(rawLen)
	for y = 0, height - 1 do
		buffer.copy(raw, y * (rowLen + 1) + 1, pixels, y * rowLen, rowLen)
	end
	local blocks = math.max(1, math.ceil(rawLen / 65535))
	local idat = buffer.create(4 + 2 + rawLen + blocks * 5 + 4)
	buffer.writestring(idat, 0, "IDAT")
	buffer.writeu8(idat, 4, 0x78)
	buffer.writeu8(idat, 5, 0x01)
	local o, pos = 6, 0
	for blockIndex = 1, blocks do
		local len = math.min(65535, rawLen - pos)
		buffer.writeu8(idat, o, blockIndex == blocks and 1 or 0)
		buffer.writeu16(idat, o + 1, len)
		buffer.writeu16(idat, o + 3, bit32.bxor(len, 0xFFFF))
		buffer.copy(idat, o + 5, raw, pos, len)
		o += 5 + len
		pos += len
	end
	local a, b = 1, 0
	for i = 0, rawLen - 1 do
		a = (a + buffer.readu8(raw, i)) % 65521
		b = (b + a) % 65521
	end
	writeBE32(idat, o, b * 65536 + a)
	local ihdr = buffer.create(17)
	buffer.writestring(ihdr, 0, "IHDR")
	writeBE32(ihdr, 4, width)
	writeBE32(ihdr, 8, height)
	buffer.writeu8(ihdr, 12, 8)
	buffer.writeu8(ihdr, 13, 6)
	local iend = buffer.create(4)
	buffer.writestring(iend, 0, "IEND")
	return "\137PNG\r\n\26\n" .. pngChunk(ihdr) .. pngChunk(idat) .. pngChunk(iend)
end

local function meshToObj(mesh)
	local lines = {}
	local indexOf = {}
	for i, id in mesh:GetVertices() do
		local p = mesh:GetPosition(id)
		indexOf[id] = i
		lines[#lines + 1] = string.format("v %.6f %.6f %.6f", p.X, p.Y, p.Z)
	end
	for _, face in mesh:GetFaces() do
		local parts = {}
		for _, id in mesh:GetFaceVertices(face) do
			parts[#parts + 1] = tostring(indexOf[id] or 0)
		end
		if #parts >= 3 then
			lines[#lines + 1] = "f " .. table.concat(parts, " ")
		end
	end
	return table.concat(lines, "\n")
end

local function cheapHash(s)
	local n = #s
	local h1, h2 = 5381, n
	local step = math.max(1, n // 4096)
	for i = 1, n, step do
		local c = string.byte(s, i)
		h1 = (h1 * 33 + c) % 4294967296
		h2 = (h2 * 131 + c) % 4294967296
	end
	return string.format("%08x%08x%x", h1, h2, n)
end

local function lowerFirst(s)
	return string.lower(string.sub(s, 1, 1)) .. string.sub(s, 2)
end

local function deriveVariableName(rhs)
	local svc = string.match(rhs, ":GetService%(\"([%w_]+)\"%)")
	if svc then
		return svc
	end
	local class = string.match(rhs, "^Instance%.new%(\"([%w_]+)\"")
	if class then
		return lowerFirst(class)
	end
	local child = string.match(rhs, ":WaitForChild%(\"([%w_ ]+)\"") or string.match(rhs, ":FindFirstChild%(\"([%w_ ]+)\"")
	if child then
		return lowerFirst(child)
	end
	local prop = string.match(rhs, "^[%a_][%w_]*%.([%a_][%w_]*)$")
	if prop then
		return lowerFirst(prop)
	end
	return nil
end

local function postProcessSource(source)
	if #source > 600000 then
		return source
	end
	local stripped = string.gsub(string.gsub(source, '"[^"\n]*"', '""'), "'[^'\n]*'", "''")
	local used = {}
	string.gsub(stripped, "()([%a_][%w_]*)", function(pos, word)
		local prev = string.sub(stripped, pos - 1, pos - 1)
		if prev ~= "." and prev ~= ":" then
			used[word] = true
		end
		return nil
	end)
	local renames = {}
	local function claim(old, base)
		if renames[old] or not base then
			return
		end
		base = string.gsub(base, "[^%w_]", "")
		if base == "" or string.match(base, "^%d") then
			return
		end
		local candidate, n = base, 1
		while used[candidate] or LUA_KEYWORDS[candidate] do
			n += 1
			candidate = base .. n
		end
		used[candidate] = true
		renames[old] = candidate
	end
	local generic = {}
	for word in used do
		if string.match(word, "^l_[%w_]+_%d+$") then
			generic[#generic + 1] = word
		end
	end
	table.sort(generic)
	for _, word in generic do
		claim(word, string.match(word, "^l_([%w_]+)_%d+$"))
	end
	for line in string.gmatch(source, "[^\n]+") do
		local name, rhs = string.match(line, "^%s*local ([%a_][%w_]*) = (.+)$")
		if name and not renames[name] and string.match(name, "^[vpu]%d+$") then
			claim(name, deriveVariableName(rhs))
		end
	end
	if next(renames) == nil then
		return source
	end
	local result = string.gsub(source, "()([%a_][%w_]*)", function(pos, word)
		local replacement = renames[word]
		if not replacement then
			return nil
		end
		local prev = string.sub(source, pos - 1, pos - 1)
		if (prev == "." or prev == ":") and string.sub(source, pos - 2, pos - 1) ~= ".." then
			return nil
		end
		return replacement
	end)
	return result
end

