    local function ReadProperty(instance,property,propertyName,special,category,optional)
        local raw=__BREAK
        local IO=InstancesOverrides[instance]
        if IO then
            local PO=IO.Properties
            if PO then local POV=PO[propertyName]; if POV~=nil then return POV end end
        end
        local CR=property.CanRead
        if CR==false then return __BREAK end
        if special then
            if gethiddenproperty then
                local ok,result=pcall(gethiddenproperty,instance,propertyName)
                if ok then raw=result end
                if filterPropVal(raw,propertyName,category) then
                    if result~=nil or not optional then property.CanRead=false end
                    return __BREAK
                end
            end
        else
            if CR then raw=instance[propertyName]
            else
                local ok,result=pcall(index,instance,propertyName)
                if ok then raw=result
                elseif gethiddenproperty then
                    ok,result=pcall(gethiddenproperty,instance,propertyName)
                    if ok then raw=result; property.Special=true end
                end
                property.CanRead=ok
                if not ok or filterPropVal(raw,propertyName,category) then return __BREAK end
            end
        end
        return raw
    end

