local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, 64 do
	B64_LOOKUP[i - 1] = string.sub(B64_CHARS, i, i)
end

local function base64EncodeSync(data)
	local len = #data
	local out = table.create(len // 3 + 2)
	local n = 0
	local i = 1
	while i + 2 <= len do
		local b1, b2, b3 = string.byte(data, i, i + 2)
		local v = b1 * 65536 + b2 * 256 + b3
		n += 1
		out[n] = B64_LOOKUP[v // 262144] .. B64_LOOKUP[(v // 4096) % 64] .. B64_LOOKUP[(v // 64) % 64] .. B64_LOOKUP[v % 64]
		i += 3
	end
	local rem = len - i + 1
	if rem == 1 then
		local v = string.byte(data, i) * 65536
		n += 1
		out[n] = B64_LOOKUP[v // 262144] .. B64_LOOKUP[(v // 4096) % 64] .. "=="
	elseif rem == 2 then
		local b1, b2 = string.byte(data, i, i + 1)
		local v = b1 * 65536 + b2 * 256
		n += 1
		out[n] = B64_LOOKUP[v // 262144] .. B64_LOOKUP[(v // 4096) % 64] .. B64_LOOKUP[(v // 64) % 64] .. "="
	end
	return table.concat(out)
end

local function makeSafeEncoder(fn)
	return function(data)
		local ok, result = pcall(fn, data)
		if ok and type(result) == "string" then
			return result
		end
		return base64EncodeSync(data)
	end
end

