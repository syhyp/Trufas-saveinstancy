		local function exportEditables(ctx)
			if #ctx.editables == 0 or not writefile then
				return
			end
			pcall(makefolder, ASSET_FOLDER)
			table.clear(EditableFiles)
			Stats.editableImages, Stats.editableMeshes = 0, 0
			for counter, instance in ctx.editables do
				pulse()
				local okName, fullName = pcall(instance.GetFullName, instance)
				fullName = okName and fullName or instance.Name
				local isImage = instance.ClassName == "EditableImage"
				local path = ASSET_FOLDER .. sanitizeFileName(instance.Name) .. "_" .. counter .. (isImage and ".png" or ".obj")
				local ok, err = pcall(function()
					if isImage then
						local size = instance.Size
						local width, height = math.floor(size.X), math.floor(size.Y)
						if width < 1 or height < 1 or width * height > OPTIONS.EditableMaxPixels then
							error("tamanho fora do limite")
						end
						writefile(path, encodePNG(width, height, instance:ReadPixelsBuffer(Vector2.zero, size)))
					else
						writefile(path, meshToObj(instance))
					end
				end)
				if ok then
					EditableFiles[#EditableFiles + 1] = path .. " <- " .. fullName
					if isImage then
						Stats.editableImages += 1
					else
						Stats.editableMeshes += 1
					end
				else
					logDropped("[" .. instance.ClassName .. " nao exportado] " .. tostring(err))
				end
			end
		end

		local function processAssets()
			if #AssetOrder == 0 or not writefile then
				return
			end
			pcall(makefolder, ASSET_FOLDER)
			if OPTIONS.DownloadAssets then
				local fetch = makeTimeoutHandler(15, function(id)
					return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. id)
				end, "timeout")
				local limit = math.min(#AssetOrder, OPTIONS.AssetDownloadLimit)
				setPhase("Baixando assets", limit)
				for i = 1, limit do
					local entry = Assets[AssetOrder[i]]
					local cachePath = ASSET_FOLDER .. "cache_" .. entry.id .. ".bin"
					local data, fromCache
					if isfile and isfile(cachePath) then
						local okRead, cached = pcall(readfile, cachePath)
						if okRead and type(cached) == "string" and #cached > 0 then
							data, fromCache = cached, true
						end
					end
					local ok = fromCache
					if not fromCache then
						ok, data = fetch(entry.id)
						if ok and type(data) == "string" and #data > 0 and #data <= OPTIONS.AssetMaxBytes and string.sub(data, 1, 10) ~= '{"errors":' then
							pcall(writefile, cachePath, data)
						else
							ok = false
						end
					end
					if ok and type(data) == "string" and #data > 0 and #data <= OPTIONS.AssetMaxBytes and string.sub(data, 1, 10) ~= '{"errors":' then
						local okWrite = pcall(writefile, ASSET_FOLDER .. entry.id .. ".bin", data)
						entry.status = okWrite and ((fromCache and "cache hit (" or "baixado (") .. #data .. " bytes)") or "falha ao gravar"
						Stats.assetsDownloaded += okWrite and 1 or 0
					else
						entry.status = "privado ou indisponivel"
						Stats.assetsFailed += 1
					end
					processed += 1
					pulse()
				end
			end
			if OPTIONS.AssetListFile then
				local lines = { "id\tusos\tstatus\texemplo" }
				for _, id in AssetOrder do
					local entry = Assets[id]
					lines[#lines + 1] = entry.id .. "\t" .. entry.uses .. "\t" .. entry.status .. "\t" .. entry.example
				end
				pcall(writefile, ASSET_FOLDER .. sanitizeFileName(placename) .. "_assets.txt", table.concat(lines, "\n"))
			end
		end

