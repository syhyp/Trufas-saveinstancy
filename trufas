    local function save_hierarchy(root_hierarchy)
        local stack = {}
        local stack_size = 0

        local function push(item)
            stack_size += 1
            stack[stack_size] = item
        end

        local function pop()
            local item = stack[stack_size]
            stack[stack_size] = nil
            stack_size -= 1
            return item
        end

        for i = #root_hierarchy, 1, -1 do
            push(root_hierarchy[i])
        end

        while stack_size > 0 do
            local item = pop()

            if type(item) == "string" then
                savebuffer[savebuffer_size] = item
                savebuffer_size += 1
                continue
            end

            local instance = item
            local IO,CTO,CNO
            if not IO then
                IO=InstancesOverrides[instance]
                if IO then CTO=IO.__ClassName end
            end
            local ClassName=instance.ClassName
            local InstanceName=instance.Name
            local SkipEntirely

            if not CTO then
                if IgnoreNotArchivable and not instance.Archivable then continue end
                SkipEntirely=IgnoreList[instance]
                if SkipEntirely then continue end
                do
                    local OIL=IgnoreList[ClassName]
                    if OIL and (OIL==true or OIL[InstanceName]) then continue end
                end
                if not DecompileIgnoring then
                    DecompileIgnoring=DecompileIgnore[instance]
                    if DecompileIgnoring==nil then
                        local DI=DecompileIgnore[ClassName]
                        if DI then DecompileIgnoring=DI==true or DI[InstanceName] end
                    end
                    if DecompileIgnoring then DecompileIgnoring=instance
                    elseif DecompileIgnoring==false then DecompileIgnoring=1 end
                end
                do
                    local Fix=NotCreatableFixes[ClassName]
                    if Fix then
                        if SaveNotCreatable then ClassName,IO=Fix,replaceClassName(instance,InstanceName,ClassName)
                        else continue end
                    else
                        if TreatUnionsAsParts and instance:IsA("PartOperation") then
                            ClassName,IO="Part",replaceClassName(instance,InstanceName,ClassName)
                            CNO="BasePart"
                        elseif not ClassList[ClassName] then
                            if __DEBUG_MODE then __DEBUG_MODE("Class not Found",ClassName) end
                            CTO=ClassName; ClassName="Folder"
                        end
                    end
                end
            end

            if IO and IO.__SaveSpecific then
                savebuffer[savebuffer_size]=save_specific(ClassName,IO.Properties)
                savebuffer_size+=1
            else
                savebuffer[savebuffer_size]=ReturnItem(CTO or ClassName,instance)
                savebuffer_size+=1; saved_count+=1
                if not (IgnorePropertiesOfNotScriptsOnScriptsMode and not isLuaSourceContainer(instance)) then
                    local di,ndi
                    if IgnoreDefaultProperties then
                        di=defaultInstances[ClassName]
                        if not di then
                            local Class=ClassList[ClassName]
                            if not Class.NotCreatable then
                                local ok,result=pcall(Instance.new,ClassName)
                                if ok then
                                    ndi=result
                                    di={}
                                    defaultInstances[ClassName]=di
                                    task.defer(function() ndi:Destroy() end)
                                else Class.NotCreatable=true end
                            end
                        end
                    end
                    for _,Property in GetInheritedProps(CNO or ClassName) do
                        local PropertyName=Property.Name
                        if IgnoreProperties[PropertyName] then continue end
                        local ValueType=Property.ValueType
                        if IgnoreSharedStrings and ValueType=="SharedString" and not KeepSharedStrings[PropertyName] then continue end
                        local Special,Category,Optional=Property.Special,Property.Category,Property.Optional
                        local raw
                        if not (ValueType=="ProtectedString" and PropertyName=="Source" and isLuaSourceContainer(instance)) then
                            raw=ReadProperty(instance,Property,PropertyName,Special,Category,Optional)
                            if raw==__BREAK then
                                local GHPF,Fallback=Property.GHPFFailed,Property.Fallback
                                if GHPF and not Fallback then continue end
                                if not GHPF then
                                    local ok,result=pcall(gethiddenproperty_fallback,instance,PropertyName)
                                    if result==nil and not Optional then ok=nil end
                                    if ok then raw=result
                                    else GHPF=true; Property.GHPFFailed=GHPF end
                                end
                                if GHPF and Fallback then
                                    local ok,result=pcall(Fallback,instance)
                                    if ok then raw=result
                                    else Property.Fallback=nil; continue end
                                end
                                if raw==__BREAK then continue end
                            end
                            if di and Property.CanRead and not Property.Special then
                                if ndi then di[PropertyName]=index(ndi,PropertyName) end
                                if di[PropertyName]==raw then continue end
                            end
                        end
                        if SharedStringOverwrite and ValueType=="BinaryString" then ValueType="SharedString" end
                        if AnonymizableTypes and AnonymizableTypes[ValueType] then
                            if ValueType=="string" then raw=gsubCI(raw,LP_Name,ANON_Name)
                            elseif raw==LP_UserId then raw=ANON_UserId end
                        end
                        local tag,value
                        if Category=="Class" then
                            tag="Ref"
                            if raw then
                                if SaveNotCreatableWillBeEnabled then
                                    local Fix=NotCreatableFixes[raw.ClassName]
                                    if Fix and (PropertyName=="PlayerToHideFrom" or ValueType~="Instance" and ValueType~=Fix) then continue end
                                end
                                value=getRef(raw)
                            else value="null" end
                        elseif Category=="Enum" then
                            value,tag=XML_Encoders.EnumItem(raw)
                        else
                            local encoder=XML_Encoders[ValueType]
                            if encoder then
                                value,tag=ReturnValueAndTag(raw,ValueType,encoder)
                            elseif ValueType=="ProtectedString" then
                                tag=ValueType
                                if PropertyName=="Source" then
                                    if DecompileIgnoring then
                                        if DecompileIgnoring==1 then DecompileIgnoring=nil end
                                        value="-- Ignored"
                                    else
                                        local should_decompile=true
                                        local LinkedSource
                                        local o,LSU=pcall(index,instance,"LinkedSource")
                                        if not o then LSU="" end
                                        local hLS=LSU~=""
                                        local LST
                                        if hLS then
                                            local Path=instance:GetFullName()
                                            if RecoveredScripts then table.insert(RecoveredScripts,Path) end
                                            LinkedSource=string.match(LSU,"%w+$")
                                            if LinkedSource then
                                                if ScriptCache then
                                                    local cached=ldeccache[LinkedSource]
                                                    if cached then value=cached; should_decompile=nil end
                                                end
                                                if should_decompile then
                                                    if DecompileJobless then value="-- Not found in LinkedSource ScriptCache"; should_decompile=nil end
                                                    LST=string.find(LinkedSource,"%a") and "hash" or "id"
                                                    local asset=LST.."="..LinkedSource
                                                    local ok,source=pcall(function()
                                                        return game:HttpGet("https://assetdelivery.roproxy.com/v1/asset/?"..asset)
                                                    end)
                                                    if ok and filterLinkedSource(source) then
                                                        if ScriptCache then ldeccache[LinkedSource]=source end
                                                        value=source; should_decompile=nil
                                                    end
                                                end
                                            else
                                                warn("FAILED TO EXTRACT ORIGINAL SCRIPT SOURCE:",instance:GetFullName(),LSU)
                                            end
                                        end
                                        if should_decompile then
                                            local iLS=instance:IsA("LocalScript")
                                            if iLS and instance.RunContext==Enum.RunContext.Server
                                                or not iLS and instance:IsA("Script") and instance.RunContext~=Enum.RunContext.Client then
                                                value="-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save"
                                            else
                                                value=ldecompile(instance)
                                                if SaveBytecode then
                                                    local out=SaveBytecode(instance)
                                                    if out then value=out..value end
                                                end
                                            end
                                        end
                                        value="-- Saved by UltraSmartSaveInstance | Patched by Trufas\n\n"
                                            ..(hLS and "-- Original Source: https://assetdelivery.roblox.com/v1/asset/?"..(LST or "id").."="..(LinkedSource or LSU).."\n\n" or "")
                                            ..value
                                    end
                                end
                                value=XML_Encoders._protectedString(value)
                            else
                                if Optional then
                                    encoder=XML_Encoders[Optional]
                                    if encoder then
                                        if raw==nil then continue
                                        else value,tag=ReturnValueAndTag(raw,ValueType,encoder) end
                                    end
                                end
                            end
                        end
                        if tag then
                            savebuffer[savebuffer_size]=ReturnProperty(tag,PropertyName,value)
                            savebuffer_size+=1
                        else
                            warn("UNSUPPORTED TYPE:",ValueType,ClassName,PropertyName)
                        end
                    end
                end
                savebuffer[savebuffer_size]="</Properties>"
                savebuffer_size+=1
                if SaveCacheInterval<savebuffer_size then save_cache() end
            end

            if SkipEntirely~=false then
                local Children=IO and IO.__Children or instance:GetChildren()
                if #Children~=0 then
                    push("</Item>")
                    if DecompileIgnoring and DecompileIgnoring==instance then
                        push("__DECOMPILE_RESET__"..tostring(instance))
                    end
                    for i = #Children, 1, -1 do
                        push(Children[i])
                    end
                    continue
                end
            end

            if DecompileIgnoring and DecompileIgnoring==instance then DecompileIgnoring=nil end
            savebuffer[savebuffer_size]="</Item>"
            savebuffer_size+=1
        end
    end

    local function save_extra(name,ioT,saveProps,ccn,source)
        if not ccn then ccn="Folder" end
        local properties={Name=name,Source=source}
        local hierarchy
        if ioT then
            if type(ioT)=="table" then hierarchy=ioT
            else
                hierarchy=ioT:GetChildren()
                if saveProps then
                    InstancesOverrides[ioT]={__ClassName=ccn,Properties=properties}
                    save_hierarchy({ioT})
                end
            end
        end
        if not saveProps then
            savebuffer[savebuffer_size]=save_specific(ccn,properties); savebuffer_size+=1
            if hierarchy then save_hierarchy(hierarchy) end
            savebuffer[savebuffer_size]="</Item>"; savebuffer_size+=1
        end
    end

    local wroteHeader = false

    local function save_game()
        do
            if IsModel then header..='<Meta name="ExplicitAutoJoints">true</Meta>' end
            if OPTIONS.AlternativeWritefile and appendfile then
                writefile(placename, header)
                wroteHeader = true
            elseif writefile and not OPTIONS.Callback then
                writefile(placename, header)
                wroteHeader = true
            end
        end
        SaveNotCreatableWillBeEnabled=SaveNotCreatable
            or (IsolateLocalPlayer or IsolateLocalPlayerCharacter) and IsolateLocalPlayer
            or IsolatePlayers
            or NilInstances and global_container.getnilinstances
        save_hierarchy(ToSaveList)
        if IsolateLocalPlayer or IsolateLocalPlayerCharacter then
            local LP=service.Players.LocalPlayer
            if LP then
                if IsolateLocalPlayer then SaveNotCreatable=true; save_extra("LocalPlayer",LP,true) end
                if IsolateLocalPlayerCharacter then
                    local LPC=LP.Character
                    if LPC then save_extra("LocalPlayer Character",LPC,true,"Model") end
                end
            end
        end
        if IsolateStarterPlayer then save_extra("StarterPlayer",service.StarterPlayer) end
        if IsolatePlayers then SaveNotCreatable=true; save_extra("Players",service.Players) end
        if NilInstances and global_container.getnilinstances then
            local ni,nis={},1
            local NIF=OPTIONS.NilInstancesFixes
            for _,instance in global_container.getnilinstances() do
                if instance==game then instance=nil
                else
                    local CN=instance.ClassName
                    local Fix=InheritsFix(NIF,CN,instance)
                    if Fix then instance=Fix(instance,InstancesOverrides) end
                    local Class=ClassList[CN]
                    if Class then if Class.Service then instance=nil end end
                end
                if instance then ni[nis]=instance; nis+=1 end
            end
            SaveNotCreatable=true; save_extra("Nil Instances",ni)
        end
        if OPTIONS.ReadMe then
            save_extra("README",nil,nil,"Script",
                "--[[\n"
                ..(#RecoveredScripts~=0 and "\t\tIMPORTANT: Original Source of these Scripts was Recovered: "..service.HttpService:JSONEncode(RecoveredScripts).."\n" or "")
                ..[[

    Saved by UltraSmartSaveInstance | Patched by Trufas

    If you didn't save in Binary (rbxl) - it's recommended to save the game right away.
    Go to FILE -> Save to File As -> Make sure File Name ends with .rbxl -> Save

    ServerStorage, ServerScriptService and Server Scripts are IMPOSSIBLE to save (FilteringEnabled).

    Fix Union/MeshPart collisions (Studio Command Bar):
    for _, v in game:GetDescendants() do
        if v:IsA("TriangleMeshPart") then v.CollisionFidelity = Enum.CollisionFidelity.Default end
    end

    Fix Camera (Studio Command Bar):
    workspace.CurrentCamera.CameraType = Enum.CameraType.Fixed
    ]]
                .."\n\tSettings: "..service.HttpService:JSONEncode(OPTIONS)
                .."\n\tElapsed: "..os.clock()-elapse_t
                .."\n\tExecutor: "..(identify_executor and table.concat({identify_executor()}," ") or "Unknown")
                .."\n]]"
            )
        end
        do
            local tmp={"<SharedStrings>"}
            for value,id in sharedStrings do
                table.insert(tmp,'<SharedString md5="'..id..'">'..value.."</SharedString>")
            end
            if 1<#tmp then
                savebuffer[savebuffer_size]=table.concat(tmp); savebuffer_size+=1
                savebuffer[savebuffer_size]="</SharedStrings>"; savebuffer_size+=1
            end
        end
        savebuffer[savebuffer_size]="<!-- Saved by UltraSmartSaveInstance | Patched by Trufas --></roblox>"
        savebuffer_size+=1
        save_cache(true)
        do
            local function buildFinal(chunks)
                if wroteHeader then return table.concat(chunks) end
                local parts=table.create(#chunks+1); parts[1]=header
                table.move(chunks,1,#chunks,2,parts)
                return table.concat(parts)
            end
            local Callback=OPTIONS.Callback
            if Callback then
                Callback(buildFinal(chunks),chunks)
            elseif OPTIONS.AlternativeWritefile and appendfile then
                local SEG=4145728; local tl=0
                for _,chunk in chunks do tl+=math.ceil(#chunk/SEG) end
                local cl=0
                for _,chunk in chunks do
                    local chl=#chunk; local offset=1
                    while offset<=chl do
                        local ss=string.sub(chunk,offset,offset+SEG-1)
                        run_with_loading("Escrevendo "..math.round(cl/tl*100).."%",nil,true,appendfile,placename,ss)
                        cl+=1; offset+=SEG
                        if offset<=chl then task.wait() end
                    end
                end
            else
                run_with_loading("Escrevendo "..get_size_format().." no arquivo",nil,true,writefile,placename,buildFinal(chunks))
            end
        end
    end

    local Connections={}
    local function Connect(event,func) table.insert(Connections,event:Connect(func)) end
    local function Cleanup()
        for _,c in Connections do c:Disconnect() end
        if LoadingThread then task.cancel(LoadingThread); LoadingThread=nil end
        GLOBAL_ENV[placename]=nil
        _removeWatermark()
    end

    do
        local Players=service.Players
        if IgnoreList.Model~=true then
            local function ic(player)
                Connect(player.CharacterAdded,function(character) IgnoreList[character]=true end)
                local Char=player.Character; if Char then IgnoreList[Char]=true end
            end
            if not OPTIONS.SavePlayerCharacters then
                Connect(Players.PlayerAdded,function(player) ic(player) end)
                for _,player in Players:GetPlayers() do ic(player) end
            else
                IgnoreNotArchivable=false
                if IsolateLocalPlayerCharacter then task.spawn(function() ic(GetLocalPlayer()) end) end
            end
        end
        if IsolateLocalPlayer and IgnoreList.Player~=true then
            task.spawn(function() IgnoreList[GetLocalPlayer()]=true end)
        end
    end

    if OPTIONS.KillAllScripts and not GLOBAL_ENV.USSI_KAS then
        GLOBAL_ENV.USSI_KAS=true
        game:GetService("ScriptContext"):SetTimeout(math.clamp(SaveCacheInterval*0.000047,20,30))
        local self=coroutine.running()
        do
            local islc=islclosure
            local isec=isexecutorclosure or checkclosure or isourclosure
            local hf=EXECUTOR_NAME~="Volt" and hookfunction
            local done={}
            local function fnk(f)
                if not f then return end
                for _,v in table.clone(f()) do
                    if not done[v] then
                        done[v]=true
                        local _t=type(v)
                        if _t=="thread" then if v~=self then pcall(coroutine.close,v) end
                        elseif _t=="function" then
                            if (not islc or islc(v)) and (not isec or not isec(v)) then
                                if hf then pcall(hf,v,coroutine.yield) end
                            end
                        end
                    end
                end
            end
            fnk(debug and debug.getregistry or getreg or getregistry)
            fnk(getallthreads); fnk(getgc)
        end
    end

    if IsolateStarterPlayer then IgnoreList.StarterPlayer=false end
    if IsolatePlayers then IgnoreList.Players=false end

    if OPTIONS.ShowStatus then
        do local E=GLOBAL_ENV.USSI_statustext; if E then E:Destroy() end end
        local SG=Instance.new("ScreenGui")
        GLOBAL_ENV.USSI_statustext=SG
        SG.DisplayOrder=2e9
        pcall(function() SG.OnTopOfCoreBlur=true end)
        StatusText=Instance.new("TextLabel")
        StatusText.Text="Iniciando save..."
        StatusText.BackgroundTransparency=1
        StatusText.Font=Enum.Font.Code
        StatusText.AnchorPoint=Vector2.new(1)
        StatusText.Position=UDim2.new(1)
        StatusText.Size=UDim2.new(0.3,0,0,20)
        StatusText.TextColor3=Color3.new(1,1,1)
        StatusText.TextScaled=true
        StatusText.TextStrokeTransparency=0.7
        StatusText.TextXAlignment=Enum.TextXAlignment.Right
        StatusText.TextYAlignment=Enum.TextYAlignment.Top
        StatusText.Parent=SG
        do
            local PT=Instance.new("Frame")
            PT.AnchorPoint=Vector2.new(0,0); PT.Position=UDim2.new(0,0,1,2)
            PT.Size=UDim2.new(1,0,0,6); PT.BackgroundColor3=Color3.new(0,0,0)
            PT.BackgroundTransparency=0.5; PT.BorderSizePixel=0; PT.Parent=StatusText
            ProgressFill=Instance.new("Frame")
            ProgressFill.Size=UDim2.new(0,0,1,0)
            ProgressFill.BackgroundColor3=Color3.fromRGB(80,170,255)
            ProgressFill.BorderSizePixel=0; ProgressFill.Parent=PT
        end
        total_count=#(ToSaveInstance or game):GetDescendants()
        local function rs()
            local l=math.random(10,20); local ra=table.create(l)
            for i=1,l do ra[i]=string.char(math.random(32,126)) end
            return table.concat(ra)
        end
        if global_container.gethui then SG.Name=rs(); SG.Parent=global_container.gethui()
        else
            if global_container.protectgui then
                SG.Name=rs(); global_container.protectgui(SG); SG.Parent=game:GetService("CoreGui")
            else
                local RG=game:GetService("CoreGui"):FindFirstChild("RobloxGui")
                if RG then SG.Parent=RG else SG.Name=rs(); SG.Parent=game:GetService("CoreGui") end
            end
        end
    end

    do
        if OPTIONS.SafeMode then
            task.spawn(function()
                local LP=GetLocalPlayer()
                local PS=LP:FindFirstChildOfClass("PlayerScripts")
                if PS then
                    local function mio(instance)
                        local children=instance:GetChildren()
                        InstancesOverrides[instance]={__Children=children}
                        for _,child in children do mio(child) end
                    end
                    mio(PS)
                    InstancesOverrides[LP]={__Children=LP:GetChildren(),Properties={Name="["..LP.ClassName.."] "..LP.Name}}
                end
                local msg="[SAVEINSTANCE SAFEMODE]\nSaving..\nDo NOT leave\nPatched by Trufas"
                local function Kick() LP:Kick(msg) end
                Kick()
                pcall(function()
                    Connect(service.GuiService.ErrorMessageChanged,function()
                        if service.GuiService:GetErrorMessage()~=msg then Kick() end
                    end)
                end)
                wait_for_render()
            end)
            if CV["BoostFPS"]==nil then OPTIONS.BoostFPS=true end
        end
        if OPTIONS.BoostFPS then pcall(function() service.RunService:Set3dRenderingEnabled(false) end) end
        if OPTIONS.AntiIdle then
            local Idled=GetLocalPlayer().Idled
            Connect(Idled,function()
                service.VirtualInputManager:SendMouseWheelEvent(
                    service.UserInputService:GetMouseLocation().X,
                    service.UserInputService:GetMouseLocation().Y,
                    true,game
                )
            end)
        end
        if not ClassList then
            do
                local UGC
                gethiddenproperty_fallback=function(instance,pn)
                    if not UGC then UGC=service.UGCValidationService end
                    return UGC:GetPropertyValue(instance,pn)
                end
                if gethiddenproperty then
                    local o,r=pcall(gethiddenproperty,workspace,"StreamOutBehavior")
                    if not o or r~=nil and typeof(r)~="EnumItem" then gethiddenproperty=nil
                    else
                        o,r=pcall(gethiddenproperty,Instance.new("AnimationRigData",Instance.new("Folder")),"parent")
                        if o and r~=nil and type(r)~="string" then gethiddenproperty=nil end
                    end
                end
                if not base64encode then
                    warn("base64encode not found")
                    Cleanup(); return
                end
            end
            do
                local ok,result=pcall(FetchAPI)
                if ok then ClassList=result
                else warn("Failed to load the API Dump"); warn(result); Cleanup(); return end
            end
        end
        do
            local ghp=gethiddenproperty or old_gethiddenproperty
            if ghp and base64encode then
                local ok1,sg=pcall(ghp,workspace.Terrain,"SmoothGrid")
                local ok2,pg=pcall(ghp,workspace.Terrain,"PhysicsGrid")
                if ok1 and ok2 and type(sg)=="string" and type(pg)=="string" then
                    local encode_ok=pcall(function()
                        cached_smoothgrid=_base64EncodeSync(sg)
                        cached_physicsgrid=_base64EncodeSync(pg)
                    end)
                    realcheck=encode_ok and cached_smoothgrid~=nil and cached_physicsgrid~=nil
                end
            end
        end
        elapse_t=os.clock()
        local ok,err=xpcall(save_game,function(e) return debug.traceback(e) end)
        if OPTIONS.BoostFPS then
            pcall(function()
                local max=5
                task.delay(math.clamp(max-(os.clock()-elapse_t),0,max),service.GuiService.ClearError,service.GuiService)
                service.RunService:Set3dRenderingEnabled(true)
            end)
        end
        if old_gethiddenproperty then gethiddenproperty=old_gethiddenproperty end
        Cleanup()
        elapse_t=os.clock()-elapse_t
        local L10=math.log10(elapse_t); local ET=10
        if StatusText then
            task.spawn(function()
                if ok then
                    StatusText.Text=string.format("Salvo! Tempo %.3fs | Tamanho %s",elapse_t,get_size_format())
                    StatusText.TextColor3=Color3.new(0,1)
                    if ProgressFill then
                        ProgressFill.Size=UDim2.new(1,0,1,0)
                        ProgressFill.BackgroundColor3=Color3.new(0,1,0)
                    end
                    task.wait(L10*2+ET)
                else
                    if LoadingThread then task.cancel(LoadingThread); LoadingThread=nil end
                    StatusText.Text="Falhou! Verifique o console F9"
                    StatusText.TextColor3=Color3.new(1)
                    warn("Error found while saving:"); warn(err)
                    task.wait(L10+ET)
                end
                StatusText:Destroy()
            end)
        end
        if OPTIONS.ShutdownWhenDone and ok then task.wait(L10*2+ET); game:Shutdown() end
    end
end

return synsaveinstance
