            end
            local NSFC=NotScriptableFixes[CN]
            local CWL,CBL=CW[CN],CB[CN]
            local ContP
            for _,M in AC.Members do
                if M.MemberType=="Property" then
                    local Ser=M.Serialization
                    if Ser.CanLoad then
                        local PN=M.Name; local VT=M.ValueType; local VTN=VT.Name
                        if VTN=="Content" or VTN=="AssetContentMap" then
                            if not ContP then
                                ContP={}
                                local o,props=pcall(service.ReflectionService.GetPropertiesOfClass,service.ReflectionService,CN,filter)
                                if o then for _,p in props do ContP[p.Name]=p.Serialized end end
                            end
                            if ContP[PN]~=nil then Ser.CanSave=ContP[PN] end
                        end
                        if (Ser.CanSave or CWL and CWL[PN]) and not (CBL and CBL[PN]) then
                            local MT=M.Tags; local Special,PDN
                            if MT then
                                for _,tag in MT do
                                    if type(tag)=="table" then PDN=tag.PreferredDescriptorName; if PDN and Special then break end
                                    elseif tag=="NotScriptable" then Special=true; if PDN then break end end
                                end
                            end
                            local pdp
                            if PDN then
                                pdp=tcd[CN][PDN]
                                if pdp==nil or (pdp.MemberType=="Property" and VTN~=pdp.ValueType) then PDN=nil end
                            end
                            local Prop={Name=PN,Category=VT.Category,ValueType=VTN,Special=Special,CanRead=nil}
                            if string.sub(VTN,1,8)=="Optional" then Prop.Optional=string.sub(VTN,9) end
                            local NSF=NSFC and NSFC[PN]
                            local af=PDN and (pdp.MemberType=="Property" and function(i) return i[PDN] end or function(i) return i[PDN](i) end)
                            Prop.Fallback=NSF and (type(NSF)=="function" and NSF or af and function(i)
                                local o,r=pcall(af,i); if o then return r end; return i[NSF]
                            end or function(i) return i[NSF] end) or af
                            CP[CPS]=Prop; CPS+=1
                        end
                    end
                end
            end
            classList[CN]=Class
        end
        return classList
    end
