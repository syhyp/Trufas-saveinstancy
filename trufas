			[CF.Hull] = 1,
			[CF.Default] = 2,
			[CF.PreciseConvexDecomposition] = 3,
			[CF.Tunable] = 7,
		}
		for cf, byte in byteMap do
			PHYSICAL_CONFIG_BY_CF[cf] = prefix .. string.char(byte) .. suffix
		end
	end

