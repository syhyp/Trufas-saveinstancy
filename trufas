			local stepY = fontSize * 1.5 + 8
			local cols = math.ceil(VP.X / stepX) + 1
			local rows = math.ceil(VP.Y / stepY) + 1
			for row = 0, rows do
				for col = 0, cols do
					local offset = (row % 2 == 0) and 0 or (stepX * 0.5)
					local t = Drawing.new("Text")
					t.Text = word
					t.Size = fontSize
					t.Color = Color3.fromRGB(220, 220, 220)
					t.Transparency = 0.78
					t.Outline = false
					t.Position = Vector2.new(col * stepX + offset - stepX * 0.25, row * stepY - stepY * 0.25)
					t.Visible = true
					WatermarkObjects[#WatermarkObjects + 1] = t
				end
			end
		end)
	end

