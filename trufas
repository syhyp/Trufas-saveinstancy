		local okClosure, closure = pcall(getscriptclosureFn, script)
		if not okClosure or type(closure) ~= "function" then
			return nil
		end
		local seen, lines, visited = {}, {}, 0
		local function addLiteral(value)
			local t = type(value)
			if (t == "string" or t == "number" or t == "boolean") and #lines < 600 then
				local key = t .. ":" .. tostring(value)
				if not seen[key] then
					seen[key] = true
					lines[#lines + 1] = luaLiteral(value)
				end
			end
		end
		local function collectFrom(fn, depth)
			if depth > 4 or visited > 200 then
				return
			end
			visited += 1
			local okC, constants = pcall(getconstantsFn, fn)
			if okC and type(constants) == "table" then
				for _, constant in constants do
					addLiteral(constant)
				end
			end
			if getupvaluesFn then
				local okU, upvalues = pcall(getupvaluesFn, fn)
				if okU and type(upvalues) == "table" then
					for _, upvalue in upvalues do
						addLiteral(upvalue)
					end
				end
			end
			if getprotosFn then
				local okP, protos = pcall(getprotosFn, fn)
				if okP and type(protos) == "table" then
					for _, proto in protos do
						if type(proto) == "function" then
							collectFrom(proto, depth + 1)
						end
					end
				end
			end
		end
		collectFrom(closure, 0)
		if #lines == 0 then
			return nil
		end
		Stats.constantsAppended += 1
		local body = string.gsub(table.concat(lines, "\n"), "%]==%]", "] == ]")
		return "--[==[ Constantes e upvalues recuperados do bytecode (" .. #lines .. "):\n" .. body .. "\n]==]"
	end

	local function extractModuleSource(module)
		if not OPTIONS.ExtractModules or not module:IsA("ModuleScript") then
			return nil
		end
		local requireModule = makeTimeoutHandler(OPTIONS.ModuleTimeout, require, "timeout")
		local ok, result = requireModule(module)
		if not ok then
			return nil
		end
		Stats.modulesExtracted += 1
		return "-- Valor retornado por require() em tempo de execucao\nreturn " .. luaLiteral(result)
	end

	local function finalizeSource(instance, value)
		if string.sub(value, 1, #DECOMPILE_FAIL_PREFIX) == DECOMPILE_FAIL_PREFIX then
			Stats.scriptsFailed += 1
			local recovered = extractModuleSource(instance)
			local constants = constantsReport(instance)
			local result = value
			if constants then
				result = constants .. "\n\n" .. result
			end
			if recovered then
				result = recovered .. "\n\n" .. result
			end
			return result
		elseif value == "-- O script esta vazio" then
			Stats.scriptsEmpty += 1
			return value
		end
		Stats.scriptsOk += 1
		if OPTIONS.PostProcessDecompile and string.sub(value, 1, 2) ~= "--" then
			local ok, processed_value = pcall(postProcessSource, value)
			if ok and type(processed_value) == "string" then
				return processed_value
			end
		end
		return value
	end

	local function filterLinkedSource(str)
		local o, r = pcall(service.HttpService.JSONDecode, service.HttpService, str)
		if o and r.errors then
			return
		end
		return true
	end

	local function sourceFor(instance, ldIgnoring)
		Stats.scripts += 1
		if ldIgnoring then
			Stats.scriptsSkipped += 1
			return "-- Ignorado"
		end
		local value
		local should_decompile = true
		local LinkedSource
		local o, LinkedSource_Url = pcall(index, instance, "LinkedSource")
		if not o then
			LinkedSource_Url = ""
		end
		local hasLinkedSource = LinkedSource_Url ~= ""
		local LinkedSource_type
		if hasLinkedSource then
			if RecoveredScripts then
				local fullName = instance:GetFullName()
				if not RecoveredSet[fullName] then
					RecoveredSet[fullName] = true
					table.insert(RecoveredScripts, fullName)
				end
			end
			LinkedSource = string.match(LinkedSource_Url, "%w+$")
			if LinkedSource then
				if ScriptCache then
					local cached = ldeccache[LinkedSource]
					if cached then
						value = cached
						should_decompile = nil
					end
				end
				if should_decompile then
					if DecompileJobless then
						value = "-- Nao encontrado no ScriptCache do LinkedSource"
						should_decompile = nil
					end
					LinkedSource_type = string.find(LinkedSource, "%a") and "hash" or "id"
					local asset = LinkedSource_type .. "=" .. LinkedSource
					local ok, source = pcall(function()
						return game:HttpGet("https://assetdelivery.roproxy.com/v1/asset/?" .. asset)
					end)
					if ok and filterLinkedSource(source) then
						if ScriptCache then
							ldeccache[LinkedSource] = source
						end
						value = source
						should_decompile = nil
					end
				end
			else
				warn("Falha ao extrair LinkedSource:", instance:GetFullName(), LinkedSource_Url)
			end
		end
		if should_decompile and not instance:IsA("LuaSourceContainer") then
			local okSource, direct = pcall(index, instance, "Source")
			if okSource and type(direct) == "string" and direct ~= "" then
				value = direct
				should_decompile = nil
			end
		end
		if should_decompile then
			local isLocalScript = instance:IsA("LocalScript")
			if
				isLocalScript and instance.RunContext == Enum.RunContext.Server
				or not isLocalScript and instance:IsA("Script") and instance.RunContext ~= Enum.RunContext.Client
			then
				value = "-- [FilteringEnabled] Scripts de servidor sao IMPOSSIVEIS de salvar"
				Stats.scriptsServer += 1
			else
				value = finalizeSource(instance, ldecompile(instance))
				if SaveBytecode then
					local output = SaveBytecode(instance)
					if output then
						value = output .. value
					end
				end
			end
		else
			Stats.scriptsOk += 1
		end
		return "-- Salvo por " .. CREDITS .. "\n\n"
			.. (hasLinkedSource and "-- Fonte original: https://assetdelivery.roblox.com/v1/asset/?" .. (LinkedSource_type or "id") .. "=" .. (LinkedSource or LinkedSource_Url) .. "\n\n" or "")
			.. (value or "")
	end

	local function replaceClassName(instance, InstanceName, ClassName)
		local InstanceOverride = InstancesOverrides[instance]
		if InstanceOverride then
			return InstanceOverride
		end
		if InstanceName ~= ClassName then
			InstanceOverride = { Properties = { Name = "[" .. ClassName .. "] " .. InstanceName } }
			InstancesOverrides[instance] = InstanceOverride
		end
		return InstanceOverride
	end

	local function isClassSerializable(className)
		local known = ClassSerializableCache[className]
		if known ~= nil then
			return known
		end
		local function getSerialized(name)
			return pcall(function()
				return service.ReflectionService:GetClass(name, REFLECTION_FILTER).Serialized
			end)
		end
		if ReflectionUsable == nil then
			local ok, partSerialized = getSerialized("Part")
			ReflectionUsable = not RiskyServicesDisabled.Reflection and ok and partSerialized == true
		end
		local serializable = true
		if ReflectionUsable then
			local ok, serialized = getSerialized(className)
			serializable = not ok or serialized == true
		end
		ClassSerializableCache[className] = serializable
		return serializable
	end

	local function refIsInvalid(target, valueType)
		if not target then
			return false
		end
		local className = target.ClassName
		local fix = NotCreatableFixes[className] or nil
		if fix then
			if not SaveNotCreatableWillBeEnabled then
				return false
			end
		elseif not isClassSerializable(className) then
			fix = "Folder"
		end
		return fix ~= nil and (valueType ~= "Instance" and valueType ~= fix)
	end

	local function nilIsValid(category, optional)
		return optional ~= nil or category == "Class"
	end

	local function filterPropVal(result, property, category, optional)
		if result == nil then
			return not nilIsValid(category, optional)
		end
		if result == "can't get value" then
			return true
		end
		if type(result) ~= "string" or #result > 256 then
			return false
		end
		if category == "Enum" then
			return true
		end
		local needle = property.ErrNeedle
		if not needle then
			needle = "Unable to get property " .. property.Name
			property.ErrNeedle = needle
		end
		return string_find(result, needle) ~= nil
	end

	local GHP_STATE_FILE = USSI_FOLDER .. "GHP_STATE.json"
	local GHPDatatypeState = {}
	local GHPPersisted = {}
	local GHPSessionFails = {}
	local GHPShadowed = true
	local GHPVersionKey
	local GHPEnabled = OPTIONS.GHPCache and writefile and readfile and true or false

	do
		GHPVersionKey = sanitizeFileName((EXECUTOR_NAME ~= "" and EXECUTOR_NAME or "UNKNOWN") .. "_" .. (EXECUTOR_VERSION ~= "" and EXECUTOR_VERSION or "0") .. "_" .. FULL_VERSION)
		if GHPEnabled then
			local ok, decoded = pcall(function()
				return service.HttpService:JSONDecode(readfile(GHP_STATE_FILE))
			end)
			if ok and type(decoded) == "table" and type(decoded[GHPVersionKey]) == "table" then
				GHPPersisted = decoded[GHPVersionKey]
			end
		end
		if OPTIONS.RetryCrashedGHP then
			for k, v in GHPPersisted do
				if v == "crashed" then
					GHPPersisted[k] = nil
				end
			end
		end
	end

	local function saveGHPState()
		if not GHPEnabled then
			return
		end
		pcall(writefile, GHP_STATE_FILE, service.HttpService:JSONEncode({ [GHPVersionKey] = GHPPersisted }))
	end

	local function ghpDatatypeAllowed(valueType)
		local state = GHPDatatypeState[valueType]
		if state ~= nil then
			return state
		end
		local persisted = GHPPersisted[valueType]
		if GHPEnabled and (persisted == "crashed" or persisted == "failed") then
			state = false
		elseif persisted == "ok" or not GHPEnabled then
			state = true
		else
			local text
			if StatusText then
				text = StatusText.Text
				StatusText.Text = "Testando ghp.. Rode de novo se travar"
			end
			wait_for_render()
			GHPPersisted[valueType] = "crashed"
			saveGHPState()
			if StatusText then
				StatusText.Text = text
			end
			state = true
		end
		GHPDatatypeState[valueType] = state
		return state
	end

	local function ghpDatatypeReport(valueType, ok, hard)
		if ok then
			GHPSessionFails[valueType] = 0
			if GHPPersisted[valueType] ~= "ok" then
				GHPPersisted[valueType] = "ok"
				GHPDatatypeState[valueType] = true
				saveGHPState()
			end
			return
		end
		if hard then
			GHPPersisted[valueType] = "failed"
			GHPDatatypeState[valueType] = false
			saveGHPState()
			return
		end
		if GHPPersisted[valueType] == "crashed" then
			GHPPersisted[valueType] = nil
			saveGHPState()
		end
		local fails = (GHPSessionFails[valueType] or 0) + 1
		GHPSessionFails[valueType] = fails
		if fails >= 30 and GHPPersisted[valueType] ~= "ok" then
			GHPDatatypeState[valueType] = false
		end
	end

	local function noteHit(property)
		property.Hits = true
	end

	local function noteFail(property)
		local f = (property.Fails or 0) + 1
		property.Fails = f
		if f >= FAIL_LIMIT and not property.Hits then
			property.CanRead = false
		end
	end

	local SweepRan = false
	local SweepOrigin = Vector3.zero
	local TerrainChunks = {}
	local TerrainChunkCount = 0
	local TerrainBlobCache

	local function encodeTerrainChunk(matGrid, occGrid, cx, cy, cz)
		local parts = { string.pack("<i4i4i4", cx, cy, cz) }
		local runMaterial, runOccupancy, runCount = 0, 0, 0
		local function flush()
			if runCount == 0 then
				return
			end
			local explicit = runMaterial ~= 0 and runOccupancy < 255
			local header = runMaterial + (explicit and 0x40 or 0) + (runCount > 1 and 0x80 or 0)
			local piece = string.char(header)
			if explicit then
				piece ..= string.char(runOccupancy)
			end
			if runCount > 1 then
				piece ..= string.char(runCount - 1)
			end
			parts[#parts + 1] = piece
			runCount = 0
		end
		for y = 1, 32 do
			for z = 1, 32 do
				for x = 1, 32 do
					local material = TERRAIN_MATERIAL_INDEX[matGrid[x][y][z]] or 0
					local occupancy = 0
					if material ~= 0 then
						occupancy = math.clamp(math.floor(occGrid[x][y][z] * 255 + 0.5), 0, 255)
					end
					if runCount > 0 and material == runMaterial and occupancy == runOccupancy and runCount < 256 then
						runCount += 1
					else
						flush()
						runMaterial, runOccupancy, runCount = material, occupancy, 1
					end
				end
			end
		end
		flush()
		return table.concat(parts)
	end

	local function readTerrainChunk(terrain, cx, cy, cz)
		local key = cx .. ":" .. cy .. ":" .. cz
		if type(TerrainChunks[key]) == "table" then
			return
		end
		local min = Vector3.new(cx * 128, cy * 128, cz * 128)
		local ok, matGrid, occGrid = pcall(terrain.ReadVoxels, terrain, Region3.new(min, min + Vector3.new(128, 128, 128)), 4)
		if not ok or type(matGrid) ~= "table" or type(occGrid) ~= "table" then
			TerrainChunks[key] = false
			return
		end
		local any = false
		for x = 1, 32 do
			local plane = matGrid[x]
			for y = 1, 32 do
				local column = plane[y]
				for z = 1, 32 do
					if column[z] ~= Enum.Material.Air then
						any = true
						break
					end
				end
				if any then
					break
				end
			end
			if any then
				break
			end
		end
		if not any then
			TerrainChunks[key] = false
			return
		end
		local okEncode, data = pcall(encodeTerrainChunk, matGrid, occGrid, cx, cy, cz)
		if okEncode then
			TerrainChunks[key] = { cx = cx, cy = cy, cz = cz, data = data }
			TerrainChunkCount += 1
		else
			TerrainChunks[key] = false
		end
		pulse()
	end

	local function terrainSmoothGrid(terrain)
		if not OPTIONS.TerrainFallback then
			return nil
		end
		local bounds = OPTIONS.TerrainBounds
		local minV, maxV
		if type(bounds) == "table" and bounds.Min and bounds.Max then
			minV, maxV = bounds.Min, bounds.Max
		else
			local radius = OPTIONS.TerrainScanRadius
			minV = SweepOrigin - Vector3.new(radius, radius / 2, radius)
			maxV = SweepOrigin + Vector3.new(radius, radius / 2, radius)
		end
		for cx = math.floor(minV.X / 128), math.floor(maxV.X / 128) do
			for cy = math.floor(minV.Y / 128), math.floor(maxV.Y / 128) do
				for cz = math.floor(minV.Z / 128), math.floor(maxV.Z / 128) do
					readTerrainChunk(terrain, cx, cy, cz)
				end
			end
		end
		local list = {}
		for _, record in TerrainChunks do
			if type(record) == "table" then
				list[#list + 1] = record
			end
		end
		if #list == 0 then
			return nil
		end
		table.sort(list, function(a, b)
			if a.cy ~= b.cy then
				return a.cy < b.cy
			elseif a.cz ~= b.cz then
				return a.cz < b.cz
			end
			return a.cx < b.cx
		end)
		local pieces = table.create(#list + 1)
		pieces[1] = "\1\5"
		for i, record in list do
			pieces[i + 1] = record.data
		end
		Stats.terrain = "reconstruido via ReadVoxels (" .. #list .. " chunks)"
		Stats.terrainSource = true
		return table.concat(pieces)
	end

	local function terrainBlobFor(instance)
		if not OPTIONS.TerrainFallback or instance.ClassName ~= "Terrain" then
			return nil
		end
		if TerrainBlobCache == nil then
			TerrainBlobCache = terrainSmoothGrid(instance) or false
		end
		return TerrainBlobCache or nil
	end

	local function noteTerrain(value)
		if Stats.terrainSource then
			return
		end
		Stats.terrain = (type(value) == "string" and #value > 0) and "ok (propriedade lida)" or "VAZIO (SmoothGrid ilegivel)"
	end

	local function breakOrTerrain(instance, propertyName)
		if propertyName == "SmoothGrid" then
			local blob = terrainBlobFor(instance)
			if blob then
				return blob
			end
		end
		return __BREAK
	end

	local function readProperty(instance, property)
		local PropertyName, ValueType, CanRead, Special = property.Name, property.ValueType, property.CanRead, property.Special

		if
			Anonymizers == nil
			and InstancesOverrides[instance] == nil
			and CanRead == true
			and not Special
			and not (ValueType == "ProtectedString" and PropertyName == "Source")
		then
			return instance[PropertyName]
		end

		local raw = __BREAK

		local InstanceOverride = InstancesOverrides[instance]
		if InstanceOverride then
			local PropertiesOverride = InstanceOverride.Properties
			if PropertiesOverride then
				local PropertyOverride = PropertiesOverride[PropertyName]
				if PropertyOverride ~= nil then
					return anonymize(PropertyOverride, ValueType)
				end
			end
		end

		if PropertyName == "SmoothGrid" and (SweepRan or OPTIONS.TerrainFallback == "always") then
			local blob = terrainBlobFor(instance)
			if blob then
				return blob
			end
		end

		if ValueType == "ProtectedString" and PropertyName == "Source" and hasSource(instance) then
			return sourceFor(instance, decompileIgnoreMap[instance])
		end

		local Category, Optional = property.Category, property.Optional
		local specialBlocked = Special and not specialAllowed(instance, PropertyName)

		if CanRead ~= false then
			local GHPKey = (Category == "Enum" or Category == "Class") and Category or ValueType

			if Special then
				if property.Shadows and GHPShadowed then
					property.CanRead = false
				elseif gethiddenproperty and not specialBlocked and ghpDatatypeAllowed(GHPKey) then
					local ok, result = pcall(gethiddenproperty, instance, PropertyName)
					if ok then
						raw = result
					end
					local filtered = filterPropVal(raw, property, Category, Optional)
					local realFailure = filtered and not (result == nil and nilIsValid(Category, Optional))
					ghpDatatypeReport(GHPKey, ok and not realFailure)
					if filtered then
						if realFailure or not ok then
							noteFail(property)
						end
						raw = __BREAK
					elseif raw ~= __BREAK then
						noteHit(property)
					else
						noteFail(property)
					end
				end
			elseif CanRead then
				raw = instance[PropertyName]
			else
				local ok, result = pcall(index, instance, PropertyName)
				if ok then
					raw = result
				elseif not (property.Shadows and GHPShadowed) and gethiddenproperty and specialAllowed(instance, PropertyName) and ghpDatatypeAllowed(GHPKey) then
					ok, result = pcall(gethiddenproperty, instance, PropertyName)
					ghpDatatypeReport(GHPKey, ok and not filterPropVal(result, property, Category, Optional))
					if ok then
						raw = result
						property.Special = true
					end
				end
				property.CanRead = ok
				if not ok or filterPropVal(raw, property, Category, Optional) then
					raw = __BREAK
				end
			end

			if raw ~= __BREAK then
				return anonymize(raw, ValueType)
			end
		end

		local GHPFFailed, Fallback = property.GHPFFailed, property.Fallback
		if GHPFFailed and not Fallback then
			return breakOrTerrain(instance, PropertyName)
		end

		if not GHPFFailed then
			local ok, result
			if gethiddenproperty_fallback and not specialBlocked then
				ok, result = pcall(gethiddenproperty_fallback, instance, PropertyName)
			end
			if result == nil and not nilIsValid(Category, Optional) then
				ok = nil
			end
			if ok then
				return anonymize(result, ValueType)
			end
			GHPFFailed = true
			property.GHPFFailed = true
		end

		if GHPFFailed and Fallback then
			local ok, result = pcall(Fallback, instance)
			if ok then
				return anonymize(result, ValueType)
			end
			property.Fallback = nil
			if __DEBUG_MODE then
				__DEBUG_MODE("Fix Failed", PropertyName, result)
			end
		end

		return breakOrTerrain(instance, PropertyName)
	end

	local function GetInheritedProps(className)
		local cached = inheritedProperties[className]
		if cached then
			return cached
		end
		local prop_list = {}
		local layer = ClassList[className]
		while layer do
			local layer_props = layer.Properties
			table.move(layer_props, 1, #layer_props, #prop_list + 1, prop_list)
			layer = ClassList[layer.Superclass]
		end
		inheritedProperties[className] = prop_list
		return prop_list
	end

	local function buildSourceClasses()
		table.clear(SourceClasses)
		for className in ClassList do
			for _, property in GetInheritedProps(className) do
				if property.Name == "Source" and property.ValueType == "ProtectedString" then
					SourceClasses[className] = true
					break
				end
			end
		end
	end

	local function getDefaultObject(class)
		local obj = defaultObjects[class]
		if obj == nil then
			local info = ClassList[class]
			if info and not info.NotCreatable then
				local ok, r = pcall(Instance.new, class)
				obj = ok and r or false
			else
				obj = false
			end
			defaultObjects[class] = obj
		end
		return obj or nil
	end

	local function fallbackValue(class, prop, binaryType)
		if not prop.Special and prop.CanRead ~= false and prop.Category ~= "Class" then
			local obj = getDefaultObject(class)
			if obj then
				local ok, v = pcall(index, obj, prop.Name)
				if ok and v ~= nil then
					return v
				end
			end
		end
		return TYPE_DEFAULTS[binaryType]
	end

	local function countSkip(reason)
		Stats.skipped[reason] = (Stats.skipped[reason] or 0) + 1
	end

	local function collect(roots)
		local ctx = {
			entries = {},
			classList = {},
			ordered = {},
			refs = {},
			editables = {},
			instCount = 0,
			instTypeCount = 0,
		}
		local entries, classList = ctx.entries, ctx.classList
		local ordered, refs = ctx.ordered, ctx.refs

		local function recur(instance, parent, ldIgnore)
			if entries[instance] then
				return
			end

			processed += 1
			pulse()

			local override = InstancesOverrides[instance]
			local tagOverride = override and override.__ClassName
			local virtual = override and override.__Virtual

			local class = virtual or instance.ClassName
			local name = virtual and override.Properties.Name or instance.Name
			local unknownTag, propClass, skipEntirely

			local own = DecompileIgnore[instance]
			if own == nil then
				local byClass = DecompileIgnore[class]
				if byClass ~= nil then
					own = byClass == true or byClass[name]
				end
			end
			if own == true then
				ldIgnore = true
			elseif own == false then
				ldIgnore = "self"
			end
			if ldIgnore then
				decompileIgnoreMap[instance] = true
			end

			if not tagOverride then
				if IgnoreNotArchivable and not instance.Archivable then
					countSkip("nao arquivavel")
					return
				end
				skipEntirely = IgnoreList[instance]
				if skipEntirely then
					countSkip("IgnoreList")
					return
				end
				local onIgnoredList = IgnoreList[class]
				if onIgnoredList == false then
					skipEntirely = false
				elseif onIgnoredList and (onIgnoredList == true or onIgnoredList[name]) then
					countSkip("IgnoreList")
					return
				end
				local fix = NotCreatableFixes[class]
				if fix then
					if not SaveNotCreatable then
						countSkip("classe nao criavel")
						return
					end
					class, override = fix, replaceClassName(instance, name, class)
					if class == "Folder" then
						propClass = "Instance"
					end
				elseif TreatUnionsAsParts and instance:IsA("PartOperation") then
					class, override = "Part", replaceClassName(instance, name, class)
					propClass = "BasePart"
				elseif not isClassSerializable(class) then
					class, override, propClass = "Folder", replaceClassName(instance, name, class), "Instance"
					HasAutoRemaps = true
				elseif not ClassList[class] then
					if __DEBUG_MODE then
						__DEBUG_MODE("Class not Found", class)
					end
					unknownTag, class, propClass = class, "Folder", "Instance"
				end
			elseif tagOverride == "Folder" then
				propClass = "Instance"
			end

			local e = {
				tag = unknownTag or tagOverride or class,
				class = tagOverride or class,
				propClass = propClass or class,
				override = override,
				propsOnly = virtual ~= nil or (override and override.__Synthetic),
				virtual = virtual ~= nil,
				parent = parent,
			}
			entries[instance] = e

			if OPTIONS.ExportEditable and not virtual and (e.class == "EditableImage" or e.class == "EditableMesh") then
				ctx.editables[#ctx.editables + 1] = instance
			end

			refs[instance] = ctx.instCount
			ctx.instCount += 1

			local bucket = e.tag
			if e.propsOnly then
				bucket ..= "\0" .. e.propClass .. "\0propsOnly"
			elseif e.propClass ~= bucket then
				bucket ..= "\0" .. e.propClass
			end
			local list = classList[bucket]
			if not list then
				list = {}
				classList[bucket] = list
				ctx.instTypeCount += 1
			end
			list[#list + 1] = instance

			local kids
			if skipEntirely ~= false then
				local children = (override and override.__Children) or (not virtual and instance:GetChildren())
				kids = table.create(#children)
				for _, child in children do
					recur(child, instance, ldIgnore == true and true or nil)
					if entries[child] then
						kids[#kids + 1] = child
					end
				end
			end
			e.children = kids or {}
			ordered[#ordered + 1] = instance
		end

		local roots_kept = table.create(#roots)
		for _, root in roots do
			recur(root)
			if entries[root] then
				roots_kept[#roots_kept + 1] = root
			end
		end
		ctx.roots = roots_kept
		return ctx
	end

	local pendingExtras = {}
	local deferredNodes = {}

	local function register_extra(name, instanceOrTable, saveProps, customClassName, source, defer)
		customClassName = customClassName or "Folder"
		local properties = { Name = name, Source = source }
		local extra = { customClassName = customClassName, properties = properties, defer = defer }
		if instanceOrTable and saveProps and type(instanceOrTable) ~= "table" then
			local existing = InstancesOverrides[instanceOrTable]
			if existing then
				existing.__ClassName = customClassName
				existing.Properties = properties
			else
				InstancesOverrides[instanceOrTable] = { __ClassName = customClassName, Properties = properties }
			end
			extra.roots = { instanceOrTable }
		else
			local children
			if instanceOrTable then
				children = type(instanceOrTable) == "table" and instanceOrTable or instanceOrTable:GetChildren()
			end
			local node = {}
			InstancesOverrides[node] = {
				__ClassName = customClassName,
				__Virtual = customClassName,
				__Children = children or {},
				Properties = properties,
			}
			extra.roots = { node }
		end
		pendingExtras[#pendingExtras + 1] = extra
		return extra
	end

	local function makeVirtual(className, name, properties, defer)
		local node = {}
		properties.Name = name
		InstancesOverrides[node] = {
			__ClassName = className,
			__Virtual = className,
			__Children = {},
			Properties = properties,
		}
		if defer then
			deferredNodes[node] = true
		end
		return node
	end

	local Assets, AssetOrder = {}, {}
	local ASSET_VALUE_TYPES = { Content = true, ContentId = true }

	local function recordAsset(value, className, propName)
		local uri = contentToUri(value)
		if not uri or uri == "" then
			return
		end
		local id = string.match(uri, "rbxassetid://(%d+)") or string.match(uri, "[?&]id=(%d+)")
		if not id then
			return
		end
		local entry = Assets[id]
		if entry then
			entry.uses += 1
		else
			Assets[id] = { id = id, uses = 1, example = className .. "." .. propName, status = "nao verificado" }
			AssetOrder[#AssetOrder + 1] = id
		end
	end

	local function readAll(objs, prop, class, binaryType)
		local n = #objs
		local vals = table.create(n)
		local missing, missingCount = {}, 0
		for i = 1, n do
			pulse()
			local raw = readProperty(objs[i], prop)
			if raw == __BREAK then
				missingCount += 1
				missing[missingCount] = i
			else
				vals[i] = raw
			end
		end
		if missingCount == n then
			logDropped(class .. "." .. prop.Name .. " (descartada)", n)
			if class == "Terrain" and (prop.Name == "SmoothGrid" or prop.Name == "PhysicsGrid") then
				logDropped("[terreno] " .. prop.Name .. " ilegivel neste executor: o terreno pode sair VAZIO")
			end
			if class == "Terrain" and prop.Name == "SmoothGrid" then
				noteTerrain(nil)
			end
			return nil, n
		end
		if missingCount > 0 then
			local dv = fallbackValue(class, prop, binaryType)
			for k = 1, missingCount do
				vals[missing[k]] = dv
			end
			logDropped(class .. "." .. prop.Name, missingCount)
		end
		if class == "Terrain" and prop.Name == "SmoothGrid" then
			noteTerrain(vals[1])
		end
		if class == "MeshPart" and prop.Name == "MeshId" then
			Stats.meshParts += n
			for i = 1, n do
				local uri = contentToUri(vals[i])
				if not uri or uri == "" then
					Stats.meshPartsNoMesh += 1
				end
			end
		end
		if ASSET_VALUE_TYPES[prop.ValueType] then
			for i = 1, n do
				recordAsset(vals[i], class, prop.Name)
			end
		end
		return vals
	end

	local function emitBinary(ctx)
		local function buildChunk(name, chunkBuf, compress)
			local uncompressedLen = chunkBuf.len
			local head = buffer.create(16)
			buffer.writestring(head, 0, name)
			if compress then
				local ok, dataStr = pcall(compress, chunkBuf:tostring())
				if ok and type(dataStr) == "string" and #dataStr < uncompressedLen then
					buffer.writeu32(head, 4, #dataStr)
					buffer.writeu32(head, 8, uncompressedLen)
					return { buf = head, len = 16, str = dataStr }
				end
			end
			buffer.writeu32(head, 8, uncompressedLen)
			return { buf = head, len = 16, tailBuf = chunkBuf.buf, tailLen = uncompressedLen }
		end

		local compress = CompressionMode == "zstd"
				and function(raw)
					return zstdcompress(raw, CompressionLevel)
				end
			or CompressionMode == "lz4" and lz4compress
			or nil

		local entries, classList = ctx.entries, ctx.classList
		local refs, ordered = ctx.refs, ctx.ordered
		local instCount, instTypeCount = ctx.instCount, ctx.instTypeCount

		local chunks, propChunks = {}, {}

		local function emit(chunk)
			chunks[#chunks + 1] = chunk
			totalsize += chunk.len + (chunk.str and #chunk.str or chunk.tailLen or 0)
		end

		local function addPropChunk(chunk)
			propChunks[#propChunks + 1] = chunk
			totalsize += chunk.len + (chunk.str and #chunk.str or chunk.tailLen or 0)
		end

		do
			local header = buffer.create(32)
			buffer.writestring(header, 0, "\60\114\111\98\108\111\120\33\137\255\13\10\26\10\0\0")
			buffer.writei32(header, 16, instTypeCount)
			buffer.writei32(header, 20, instCount)
			emit({ buf = header, len = 32 })
		end

		if IsModel then
			local metaBuf = StreamBuffer.new(64)
			metaBuf:writeu32(1)
			metaBuf:writeLenString("ExplicitAutoJoints")
			metaBuf:writeLenString("true")
			emit(buildChunk("META", metaBuf, compress))
		end

		local sstrSlot = #chunks + 1
		local sharedStringCtx = { count = 0, order = {}, hashes = {} }
		local classId = 0
		local deferredBuckets

		local function encode_class_bucket(objs)
			local n = #objs
			local entry = entries[objs[1]]
			local class = entry.class

			local instBuf = StreamBuffer.new(64 + 4 * n)
			instBuf:writeu32(classId)
			instBuf:writeLenString(class)
			local classInfo = ClassList[class]
			local isService = classInfo and classInfo.Service
			instBuf:writeu8(isService and 1 or 0)
			instBuf:writeu32(n)
			writeRefPlane(instBuf, n, instBuf:allocRegion(4 * n), function(i)
				return refs[objs[i]]
			end)
			if isService then
				buffer.fill(instBuf.buf, instBuf:allocRegion(n), 1, n)
			end
			emit(buildChunk("INST", instBuf, compress))

			local skipProps = IgnorePropertiesOfNotScriptsOnScriptsMode
				and not entry.propsOnly
				and not hasSource(objs[1])

			if entry.propsOnly then
				for propName in entry.override.Properties do
					local isSource = propName == "Source"
					local buf = StreamBuffer.new(64 + n * 16)
					buf:writeu32(classId)
					buf:writeLenString(propName)
					buf:writeu8(isSource and Type_Ids.ProtectedString or Type_Ids.string)
					for i = 1, n do
						local value = entries[objs[i]].override.Properties[propName]
						if type(value) == "function" then
							value = value()
						end
						buf:writeLenString(value or "")
					end
					addPropChunk(buildChunk("PROP", buf, not isSource and compress or nil))
				end
			elseif not skipProps then
				for _, prop in GetInheritedProps(entry.propClass) do
					local propName = prop.Name
					if IgnoreProperties[propName] then
						continue
					end
					local valueType = prop.ValueType
					if SharedBinaryStrings and valueType == "BinaryString" then
						valueType = "SharedString"
					end
					local binaryType = valueType
					local refCtxArg = nil
					if prop.Category == "Enum" then
						binaryType = "Enum"
					elseif prop.Category == "Class" then
						binaryType = "Referent"
						refCtxArg = refs
					elseif binaryType == "Content" then
						refCtxArg = refs
					end
					local encoder = Binary_Encoders[binaryType]
					local typeId = Type_Ids[binaryType]
					if typeId == Type_Ids.SharedString then
						refCtxArg = sharedStringCtx
					end
					if not (encoder and typeId) then
						noteUnsupportedType(class, propName, binaryType)
						continue
					end

					local vals, failedCount = readAll(objs, prop, class, binaryType)
					if not vals then
						if __DEBUG_MODE then
							__DEBUG_MODE("PROP descartada", class, propName, "n=" .. n)
						end
						continue
					end

					if (SaveNotCreatableWillBeEnabled or HasAutoRemaps) and prop.Category == "Class" then
						for i = 1, n do
							if refIsInvalid(vals[i], valueType) then
								vals[i] = nil
							end
						end
					end

					local propBuf = StreamBuffer.new(128 + n * 4)
					propBuf:writeu32(classId)
					propBuf:writeLenString(propName)
					propBuf:writeu8(typeId)
					local ok, err = pcall(encoder, propBuf, vals, n, refCtxArg)
					if ok then
						addPropChunk(buildChunk("PROP", propBuf, compress))
					else
						logDropped(class .. "." .. propName .. " (erro de codificacao)", n)
						warn("Falha ao codificar", class .. "." .. propName, err)
					end
				end
			end

			classId += 1
			processed += n
			pulse()
		end

		for _, objs in classList do
			if entries[objs[1]].deferLast then
				deferredBuckets = deferredBuckets or {}
				table.insert(deferredBuckets, objs)
			else
				encode_class_bucket(objs)
			end
		end

		if deferredBuckets then
			for _, objs in deferredBuckets do
				encode_class_bucket(objs)
			end
		end

		if sharedStringCtx.count > 0 then
			local sstrBuf = StreamBuffer.new(64 + sharedStringCtx.count * 32)
			sstrBuf:allocRegion(4)
			sstrBuf:writeu32(sharedStringCtx.count)
			for i = 1, sharedStringCtx.count do
				sstrBuf:allocRegion(16)
				sstrBuf:writeLenString(sharedStringCtx.order[i])
			end
			local chunk = buildChunk("SSTR", sstrBuf, compress)
			table.insert(chunks, sstrSlot, chunk)
			totalsize += chunk.len + (chunk.str and #chunk.str or chunk.tailLen or 0)
		end

		if #propChunks > 0 then
			table.move(propChunks, 1, #propChunks, #chunks + 1, chunks)
		end

		do
			local prntBuf = StreamBuffer.new(16 + instCount * 8)
			prntBuf:allocRegion(1)
			prntBuf:writeu32(instCount)
			local objBase = prntBuf:allocRegion(4 * instCount)
			local parBase = prntBuf:allocRegion(4 * instCount)
			writeRefPlane(prntBuf, instCount, objBase, function(i)
				return refs[ordered[i]]
			end)
			writeRefPlane(prntBuf, instCount, parBase, function(i)
				local par = entries[ordered[i]].parent
				return (par and refs[par]) or -1
			end)
			emit(buildChunk("PRNT", prntBuf, compress))
		end

		do
			local endBuf = StreamBuffer.new(16)
			endBuf:writestring("</roblox>")
			emit(buildChunk("END\0", endBuf, nil))
		end

		local out = table.create(#chunks)
		for i, c in chunks do
			local payloadLen = c.str and #c.str or c.tailLen or 0
			if payloadLen == 0 then
				out[i] = buffer.readstring(c.buf, 0, c.len)
				continue
			end
			local chunkBuf = buffer.create(c.len + payloadLen)
			buffer.copy(chunkBuf, 0, c.buf, 0, c.len)
			if c.str then
				buffer.writestring(chunkBuf, c.len, c.str)
			else
				buffer.copy(chunkBuf, c.len, c.tailBuf, 0, payloadLen)
			end
			out[i] = buffer.tostring(chunkBuf)
		end
		return out
	end

	local function emitXML(ctx)
		local chunks = table.create(1)
		local savebuffer, savebuffer_size = {}, 1
		local header = "<!-- Salvo por " .. CREDITS .. " --><roblox version=\"4\">"
		local refs = ctx.refs

		local function ReturnProperty(tag, propertyName, value)
			return "<" .. tag .. ' name="' .. propertyName .. '">' .. value .. "</" .. tag .. ">"
		end

		local function ReturnValueAndTag(raw, valueType, encoder)
			local value, tag = (encoder or XML_Encoders[valueType])(raw)
			return value, tag or valueType
		end

		local function ReturnItem(className, instance)
			return '<Item class="' .. className .. '" referent="' .. refs[instance] .. '"><Properties>'
		end

		local function save_cache()
			local savestr = table.concat(savebuffer)
			totalsize += #savestr
			table.insert(chunks, savestr)
			table.clear(savebuffer)
			savebuffer_size = 1
			refreshStatus()
			wait_for_render()
		end

		local function save_hierarchy(hierarchy, ctx)
			local entries = ctx.entries
			for _, instance in hierarchy do
				local entry = entries[instance]
				if not entry then
					continue
				end

				processed += 1
				pulse()

				savebuffer[savebuffer_size] = ReturnItem(entry.tag, instance)
				savebuffer_size += 1

				if entry.propsOnly then
					for propName, value in entry.override.Properties do
						if type(value) == "function" then
							value = value()
						end
						if value ~= nil then
							if propName == "Source" then
								savebuffer[savebuffer_size] = ReturnProperty("ProtectedString", propName, XML_Encoders._protectedString(value))
							else
								savebuffer[savebuffer_size] = ReturnProperty("string", propName, XML_Encoders.string(value))
							end
							savebuffer_size += 1
						end
					end
				elseif not (IgnorePropertiesOfNotScriptsOnScriptsMode and not hasSource(instance)) then
					local default_instance, new_def_inst
					if IgnoreDefaultProperties then
						default_instance = defaultInstances[entry.class]
						if not default_instance then
							local Class = ClassList[entry.class]
							if not Class.NotCreatable then
								local ok, result = pcall(Instance.new, entry.class)
								if ok then
									new_def_inst = result
									default_instance = {}
									defaultInstances[entry.class] = default_instance
								else
									Class.NotCreatable = true
								end
							end
						end
					end
					for _, Property in GetInheritedProps(entry.propClass) do
						local PropertyName = Property.Name
						if IgnoreProperties[PropertyName] then
							continue
						end
						local ValueType = Property.ValueType
						local Category, Optional = Property.Category, Property.Optional
						local raw = readProperty(instance, Property)
						if PropertyName == "SmoothGrid" and entry.class == "Terrain" then
							noteTerrain(raw ~= __BREAK and raw or nil)
						end
						if raw == __BREAK then
							continue
						end
						if ASSET_VALUE_TYPES[ValueType] then
							recordAsset(raw, entry.class, PropertyName)
						end
						if entry.class == "MeshPart" and PropertyName == "MeshId" then
							Stats.meshParts += 1
							local uri = contentToUri(raw)
							if not uri or uri == "" then
								Stats.meshPartsNoMesh += 1
							end
						end
						if default_instance and Property.CanRead and not Property.Special and ValueType ~= "ProtectedString" then
							if new_def_inst then
								default_instance[PropertyName] = index(new_def_inst, PropertyName)
							end
							if default_instance[PropertyName] == raw then
								continue
							end
						end
						if SharedBinaryStrings and ValueType == "BinaryString" then
							ValueType = "SharedString"
						end
						local tag, value
						if Category == "Class" then
							tag = "Ref"
							if raw and refs[raw] ~= nil and not refIsInvalid(raw, ValueType) then
								value = refs[raw]
							else
								value = "null"
							end
						elseif Category == "Enum" then
							value, tag = XML_Encoders.EnumItem(raw)
						else
							local encoder = XML_Encoders[ValueType]
							if encoder then
								local ok, v, t = pcall(encoder, raw)
								if ok then
									value, tag = v, t or ValueType
								else
									logDropped(entry.class .. "." .. PropertyName)
									continue
								end
							elseif Optional then
								encoder = XML_Encoders[Optional]
								if encoder then
									if raw == nil then
										continue
									end
									value, tag = ReturnValueAndTag(raw, ValueType, encoder)
								end
							end
						end
						if tag then
							savebuffer[savebuffer_size] = ReturnProperty(tag, PropertyName, value)
							savebuffer_size += 1
						else
							noteUnsupportedType(entry.class, PropertyName, ValueType)
						end
					end
				end

				savebuffer[savebuffer_size] = "</Properties>"
				savebuffer_size += 1

				if SaveCacheInterval < savebuffer_size then
					save_cache()
				end

				local children = entry.children
				if #children ~= 0 then
					save_hierarchy(children, ctx)
				end

				savebuffer[savebuffer_size] = "</Item>"
				savebuffer_size += 1
			end
		end

		if IsModel then
			header ..= '<Meta name="ExplicitAutoJoints">true</Meta>'
		end

		savebuffer[savebuffer_size] = header
		savebuffer_size += 1

		save_hierarchy(ctx.mainRoots, ctx)

		for _, extra in pendingExtras do
			save_hierarchy(extra.collectedRoots, ctx)
		end

		do
			local tmp = { "<SharedStrings>" }
			for value, id in sharedStrings do
				table.insert(tmp, '<SharedString md5="' .. id .. '">' .. value .. "</SharedString>")
			end
			if 1 < #tmp then
				savebuffer[savebuffer_size] = table.concat(tmp)
				savebuffer_size += 1
				savebuffer[savebuffer_size] = "</SharedStrings>"
				savebuffer_size += 1
			end
		end

		savebuffer[savebuffer_size] = "</roblox>"
		savebuffer_size += 1
		save_cache()
		return chunks
	end

	local function validateReferents(ctx)
		local refs, entries = ctx.refs, ctx.entries
		local seen, count = {}, 0
		for _, ref in refs do
			if ref < 0 or ref >= ctx.instCount or seen[ref] then
				return "referente duplicado ou fora da faixa"
			end
			seen[ref] = true
			count += 1
		end
		if count ~= ctx.instCount then
			return "numero de referentes diverge da contagem de instancias"
		end
		if #ctx.ordered ~= ctx.instCount then
			return "lista de instancias (PRNT) diverge da contagem"
		end
		for _, e in entries do
			if e.parent ~= nil and refs[e.parent] == nil then
				return "instancia com pai sem referente (PRNT)"
			end
		end
		return nil
	end

	local function validateOutput(chunks, ctx)
		if not OPTIONS.Validate then
			return nil
		end
		local ok, result = pcall(function()
			local refProblem = validateReferents(ctx)
			if refProblem then
				return refProblem
			end
			if OPTIONS.Binary then
				local head = chunks[1]
				if #head ~= 32 or string.sub(head, 1, 8) ~= "<roblox!" then
					return "cabecalho invalido"
				end
				local types, count = string.unpack("<i4i4", head, 17)
				if types ~= ctx.instTypeCount or count ~= ctx.instCount then
					return "contagem de instancias divergente"
				end
				local instChunks, prntChunks = 0, 0
				for i = 2, #chunks do
					local c = chunks[i]
					if #c < 16 then
						return "chunk truncado (#" .. i .. ")"
					end
					local name = string.sub(c, 1, 4)
					local comp, uncomp = string.unpack("<I4I4", c, 5)
					local expected = comp > 0 and comp or uncomp
					if #c - 16 ~= expected then
						return "tamanho inconsistente no chunk " .. name
					end
					if name == "INST" then
						instChunks += 1
					elseif name == "PRNT" then
						prntChunks += 1
					end
				end
				if instChunks ~= ctx.instTypeCount then
					return "numero de chunks INST diverge do cabecalho"
				end
				if prntChunks ~= 1 then
					return "chunk PRNT ausente ou duplicado"
				end
				local last = chunks[#chunks]
				if string.sub(last, 1, 3) ~= "END" or string.sub(last, -9) ~= "</roblox>" then
					return "chunk END ausente"
				end
			else
				local first = chunks[1]
				if not first or not string_find(string.sub(first, 1, 200), "<roblox", 1) then
					return "inicio do XML ausente"
				end
				if string.sub(chunks[#chunks], -9) ~= "</roblox>" then
					return "fim do XML ausente"
				end
			end
			return nil
		end)
		if not ok then
			return tostring(result)
		end
		return result
	end

	local function optionsSummary()
		local t = {}
