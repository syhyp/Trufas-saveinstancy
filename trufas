local StreamBuffer = {}
StreamBuffer.__index = StreamBuffer

function StreamBuffer.new(cap)
	cap = math.max(cap or 64, 16)
	return setmetatable({ buf = buffer.create(cap), len = 0, cap = cap }, StreamBuffer)
end

function StreamBuffer:reserve(n)
	local need = self.len + n
	if need > self.cap then
		local nc = math.max(self.cap * 2, need)
		local nb = buffer.create(nc)
		buffer.copy(nb, 0, self.buf, 0, self.len)
		self.buf = nb
		self.cap = nc
	end
end

function StreamBuffer:allocRegion(n)
	self:reserve(n)
	local o = self.len
	self.len = o + n
	return o
end

function StreamBuffer:writeu8(v)
	self:reserve(1)
	buffer.writeu8(self.buf, self.len, v)
	self.len += 1
end

function StreamBuffer:writeu16(v)
	self:reserve(2)
	buffer.writeu16(self.buf, self.len, v)
	self.len += 2
end

function StreamBuffer:writeu32(v)
	self:reserve(4)
	buffer.writeu32(self.buf, self.len, v)
	self.len += 4
end

function StreamBuffer:writestring(s)
	local l = #s
	if l == 0 then
		return
	end
	self:reserve(l)
	buffer.writestring(self.buf, self.len, s)
	self.len += l
end

function StreamBuffer:writeLenString(s)
	self:writeu32(#s)
	self:writestring(s)
end

function StreamBuffer:tostring()
	return buffer.readstring(self.buf, 0, self.len)
end

