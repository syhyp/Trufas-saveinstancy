	local function streamingSweep()
		local okStreaming, streaming = pcall(function()
			return workspace.StreamingEnabled
		end)
		if not (OPTIONS.StreamingSweep and okStreaming and streaming) then
			return
		end
		local player = GetLocalPlayer()
		local deadline = os.clock() + 8
		while os.clock() < deadline and not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) do
			task.wait(0.1)
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera
		if not root or not camera then
			warn("[USSI] Varredura de streaming ignorada: personagem ou camera indisponivel")
			return
		end
		local originCFrame, originGravity = root.CFrame, workspace.Gravity
		local originCameraType, originCameraCFrame = camera.CameraType, camera.CFrame
		SweepOrigin = originCFrame.Position
		local terrain = workspace:FindFirstChildOfClass("Terrain")

		local function cacheTerrainAround(position)
			local radius = OPTIONS.TerrainReadRadius
			for cx = math.floor((position.X - radius) / 128), math.floor((position.X + radius) / 128) do
				for cy = math.floor((position.Y - 256) / 128), math.floor((position.Y + 256) / 128) do
					for cz = math.floor((position.Z - radius) / 128), math.floor((position.Z + radius) / 128) do
						readTerrainChunk(terrain, cx, cy, cz)
					end
				end
			end
		end

		local function visit(position)
			root.CFrame = CFrame.new(position)
			root.AssemblyLinearVelocity = Vector3.zero
			camera.CFrame = CFrame.new(position + Vector3.new(0, 50, 0), position)
			local limit = os.clock() + OPTIONS.SweepWait * 5
			task.wait(0.1)
			while os.clock() < limit and os.clock() - Accum.lastAddedAt < OPTIONS.SweepWait do
				task.wait(0.05)
			end
			if terrain and OPTIONS.TerrainFallback then
				cacheTerrainAround(position)
			end
		end

		local function currentBounds()
			local bounds = OPTIONS.SweepBounds
			local minV, maxV
			if type(bounds) == "table" and bounds.Min and bounds.Max then
				minV, maxV = bounds.Min, bounds.Max
			else
				minV = Accum.min or originCFrame.Position
				maxV = Accum.max or originCFrame.Position
			end
			local limit = OPTIONS.SweepMaxExtent
			return Vector3.new(math.clamp(minV.X, -limit, limit), math.clamp(minV.Y, -limit, limit), math.clamp(minV.Z, -limit, limit)),
				Vector3.new(math.clamp(maxV.X, -limit, limit), math.clamp(maxV.Y, -limit, limit), math.clamp(maxV.Z, -limit, limit))
		end

		local ok, err = pcall(function()
			workspace.Gravity = 0
			camera.CameraType = Enum.CameraType.Scriptable
			Accum.tracking = true
			Accum.min, Accum.max = nil, nil
			for _, instance in workspace:GetDescendants() do
				trackBounds(instance)
			end
			local radius = 256
			pcall(function()
				radius = workspace.StreamingTargetRadius
			end)
			local step = OPTIONS.SweepStep or math.clamp(radius * 1.2, 96, 1024)
			local visited, count = {}, 0
			local progressed = true
			while progressed and count < OPTIONS.SweepMaxPoints do
				progressed = false
				local minV, maxV = currentBounds()
				for ix = math.floor(minV.X / step), math.ceil(maxV.X / step) do
					for iy = math.floor(minV.Y / step), math.ceil(maxV.Y / step) do
						for iz = math.floor(minV.Z / step), math.ceil(maxV.Z / step) do
							local key = ix .. ":" .. iy .. ":" .. iz
							if count < OPTIONS.SweepMaxPoints and not visited[key] then
								visited[key] = true
								count += 1
								progressed = true
								if StatusText then
									StatusText.Text = "Varredura de streaming: ponto " .. count
								end
								visit(Vector3.new(ix * step, iy * step, iz * step))
							end
						end
					end
				end
			end
			Stats.sweepPoints = count
		end)

		pcall(function()
			root.CFrame = originCFrame
			root.AssemblyLinearVelocity = Vector3.zero
			workspace.Gravity = originGravity
			camera.CameraType = originCameraType
			camera.CFrame = originCameraCFrame
		end)
		Accum.tracking = false
		SweepRan = Stats.sweepPoints > 0
		if not ok then
			warn("[USSI] Varredura de streaming interrompida:", err)
		end
	end

	streamingSweep()

	if OPTIONS.SafeMode and CustomOptions_valid["KillAllScripts"] == nil then
		OPTIONS.KillAllScripts = true
	end

	if OPTIONS.KillAllScripts and not GLOBAL_ENV.USSI_KAS then
		GLOBAL_ENV.USSI_KAS = true
		game:GetService("ScriptContext"):SetTimeout(math.clamp(SaveCacheInterval * 0.000047, 20, 30))
		local self = coroutine.running()
		do
			local islclosure = islclosure
			local isexecutorclosure = isexecutorclosure or checkclosure or isourclosure
			local hookfunction = not IS_VOLT_EXECUTOR and hookfunction
			local done = {}
			local function filterNkill(f)
				if not f then
					return
				end
				for _, v in table.clone(f()) do
					if not done[v] then
						done[v] = true
						local _type = type(v)
						if _type == "thread" then
							if v ~= self then
								pcall(coroutine.close, v)
							end
						elseif _type == "function" then
							if (not islclosure or islclosure(v)) and (not isexecutorclosure or not isexecutorclosure(v)) then
								if hookfunction then
									pcall(hookfunction, v, coroutine.yield)
								end
							end
						end
					end
				end
			end
			filterNkill(debug and debug.getregistry or getreg or getregistry)
			filterNkill(getallthreads)
			filterNkill(getgc)
		end
	end

	if IsolateStarterPlayer then
		IgnoreList.StarterPlayer = false
	end

	if not IsolatePlayers and CustomOptions_valid.SaveNotCreatable == nil then
		IgnoreList.Player = true
	end

	local kickSnapshot = GLOBAL_ENV.USSI_kicksnapshot
	if not kickSnapshot then
		kickSnapshot = {}
		GLOBAL_ENV.USSI_kicksnapshot = kickSnapshot
	end

	local function snapshotKick(LocalPlayer)
		local cached = kickSnapshot[LocalPlayer]
		if not cached then
			cached = { [LocalPlayer] = LocalPlayer:GetChildren() }
			local ps = LocalPlayer:FindFirstChildOfClass("PlayerScripts")
			local function walk(inst)
				local kids = inst:GetChildren()
				cached[inst] = kids
				for _, child in kids do
					walk(child)
				end
			end
			if ps then
				walk(ps)
			end
			kickSnapshot[LocalPlayer] = cached
		end
		for inst, kids in cached do
			InstancesOverrides[inst] = { __Children = kids }
		end
	end

	if OPTIONS.SafeMode then
		task.spawn(function()
			local LocalPlayer = GetLocalPlayer()
			snapshotKick(LocalPlayer)
			if OPTIONS.SafeModeDelay > 0 then
				task.wait(OPTIONS.SafeModeDelay)
			end
			local msg = "[SAVEINSTANCE SAFEMODE]\nSalvando..\nNao saia do jogo\nPatched by Trufas\nPara desativar: SafeMode=false"
			local function Kick()
				LocalPlayer:Kick(msg)
			end
			Kick()
			pcall(function()
				Connect(service.GuiService.ErrorMessageChanged, function()
					if service.GuiService:GetErrorMessage() ~= msg then
						Kick()
					end
				end)
			end)
			wait_for_render()
		end)
		if CustomOptions_valid["BoostFPS"] == nil then
			OPTIONS.BoostFPS = true
		end
	end

	local function childrenOf(instance)
		local override = InstancesOverrides[instance]
		return override and override.__Children or instance:GetChildren()
	end

	if OPTIONS.IgnoreDefaultPlayerScripts then
		local default_scripts = arrayToDict({
			ModuleScript = { "PlayerModule" },
			LocalScript = { "BubbleChat", "ChatScript", "PlayerScriptsLoader", "RbxCharacterSounds" },
		}, true)
		local function ignorePath(path)
			if path then
				for _, child in childrenOf(path) do
					local class_match = default_scripts[child.ClassName]
					if class_match and class_match[child.Name] then
						DecompileIgnore[child] = true
					end
					ignorePath(child)
				end
			end
		end
		ignorePath(service.StarterPlayer)
		local LocalPlayer = service.Players.LocalPlayer
		if LocalPlayer then
			for _, child in childrenOf(LocalPlayer) do
				if child:IsA("PlayerScripts") then
					ignorePath(child)
					break
				end
			end
		end
	end

	if OPTIONS.BoostFPS then
		pcall(function()
			service.RunService:Set3dRenderingEnabled(false)
		end)
	end

	if OPTIONS.AntiIdle then
		local Idled = GetLocalPlayer().Idled
		Connect(Idled, function()
			service.VirtualInputManager:SendMouseWheelEvent(
				service.UserInputService:GetMouseLocation().X,
				service.UserInputService:GetMouseLocation().Y,
				true,
				game
			)
		end)
	end

	local RiskyOption = OPTIONS.RiskyServicesDisabled
	RiskyServicesDisabled = type(RiskyOption) == "table" and table.clone(RiskyOption) or {}
	if not gethiddenproperty and CustomOptions_valid.RiskyServicesDisabled == nil then
		RiskyServicesDisabled.UGC = false
	end
	gethiddenproperty_fallback = nil
	if not RiskyServicesDisabled.UGC then
		gethiddenproperty_fallback = function(instance, propertyName)
			return service.UGCValidationService:GetPropertyValue(instance, propertyName)
		end
	end

	if gethiddenproperty and not SetupCache.ghpChecked then
		local ard = Instance.new("AnimationRigData")
		local GHP_SELF_CHECKS = {
			{
				key = "boolean",
				fatal = true,
				test = function()
					return type(gethiddenproperty(game, "ForceR15")) == "boolean"
				end,
			},
			{
				key = "Enum",
				test = function()
					local r = gethiddenproperty(workspace, "StreamOutBehavior")
					return r == nil or typeof(r) == "EnumItem"
				end,
			},
			{
				key = "Color3uint8",
				retest = true,
				test = function()
					local terrain = workspace.Terrain
					return gethiddenproperty(terrain, "Color3uint8") == terrain.Color
				end,
			},
			{
				key = "int64",
				retest = true,
				test = function()
					return gethiddenproperty(ard, "SourceAssetId") == ard.SourceAssetId
				end,
			},
			{
				key = "BinaryString",
				retest = true,
				test = function()
					ard:SetAttribute("test", "test")
					return gethiddenproperty(ard, "AttributesSerialize") == "\1\0\0\0\4\0\0\0test\2\4\0\0\0test"
				end,
			},
			{
				key = "SharedString",
				test = function()
					ard:AddTag("\1test\2\4test")
					return gethiddenproperty(ard, "Tags") == "\1test\2\4test"
				end,
			},
			{
				key = "NetAssetRef",
				test = function()
					return type(gethiddenproperty(Instance.new("MeshPart"), "SolidMeshHolder")) == "string"
				end,
			},
			{
				dep = "BinaryString",
				test = function()
					ard.Parent = Instance.new("Folder")
					local ok, r = pcall(gethiddenproperty, ard, "parent")
					GHPShadowed = ok and r ~= nil and type(r) ~= "string"
					return not GHPShadowed
				end,
			},
		}

		local statusShown
		for _, check in GHP_SELF_CHECKS do
			local key = check.key
			if key then
				local state = GHPPersisted[key]
				if state == "crashed" then
					if check.fatal then
						gethiddenproperty = nil
						break
					end
					continue
				elseif state and check.fatal and state ~= "ok" then
					gethiddenproperty = nil
					break
				elseif state and not check.retest then
					continue
				end
			end
			if check.dep and GHPPersisted[check.dep] == "crashed" then
				continue
			end
			if key then
				GHPPersisted[key] = "crashed"
				saveGHPState()
			end
			if StatusText and not statusShown then
				statusShown = true
				StatusText.Text = "Testando ghp. Rode de novo se travar"
				wait_for_render()
			end
			local ok, passed = pcall(check.test)
			passed = ok and passed and true or false
			if key then
				ghpDatatypeReport(key, passed, true)
			end
			if not passed and check.fatal then
				gethiddenproperty = nil
				break
			end
		end
		pcall(function()
			ard:Destroy()
		end)
		SetupCache.ghpChecked = true
		SetupCache.ghpFatal = (gethiddenproperty == nil)
		SetupCache.ghpShadowed = GHPShadowed
	elseif SetupCache.ghpChecked then
		GHPShadowed = SetupCache.ghpShadowed ~= false
		if SetupCache.ghpFatal then
			gethiddenproperty = nil
		end
	end

	if not gethiddenproperty and CustomOptions_valid.RiskyServicesDisabled == nil then
		RiskyServicesDisabled.UGC = false
		gethiddenproperty_fallback = function(instance, propertyName)
			return service.UGCValidationService:GetPropertyValue(instance, propertyName)
		end
	end

	do
		local function pickFastestBy(candidates, works, iters, benchInput)
			local valid = {}
			for _, f in candidates do
				if f then
					local ok, good = pcall(works, f)
					if ok and good then
						valid[#valid + 1] = f
					end
				end
			end
			if #valid == 0 then
				return nil
			elseif #valid == 1 then
				return valid[1]
			end
			local best, bestTime
			for _, f in valid do
				local start = os.clock()
				for _ = 1, iters do
					pcall(f, benchInput)
				end
				local t = os.clock() - start
				if not bestTime or t < bestTime then
					best, bestTime = f, t
				end
			end
			return best
		end

		local es_encode, es_decode, es_zstdcompress
		if not RiskyServicesDisabled.Encoding then
			local okES, EncodingService = pcall(game.GetService, game, "EncodingService")
			if okES and EncodingService then
				es_encode = function(raw)
					return buffer.tostring(EncodingService:Base64Encode(buffer.fromstring(raw)))
				end
				es_decode = function(raw)
					return buffer.tostring(EncodingService:Base64Decode(buffer.fromstring(raw)))
				end
				local okEnum, ZSTD_ALGO_ENUM = pcall(function()
					return Enum.CompressionAlgorithm.Zstd
				end)
				if okEnum then
					es_zstdcompress = function(raw, level)
						return buffer.tostring(EncodingService:CompressBuffer(buffer.fromstring(raw), ZSTD_ALGO_ENUM, level))
					end
				end
			end
		end

		local BASE64_TEST = string.rep("\1\0\0\0\1\2\3\4\5\6\7", 50)

		if not SetupCache.b64Picked then
			SetupCache.b64Picked = true
			base64encode = makeSafeEncoder(pickFastestBy({ base64encode, es_encode, base64EncodeSync }, function(f)
				return f("\1\0\0\0\1") == "AQAAAAE=" and f("\1\0") == "AQA=" and f("\1") == "AQ=="
			end, 50, BASE64_TEST) or base64EncodeSync)

			base64decode = pickFastestBy({ base64decode, es_decode }, function(f)
				return f("AQAAAAE=") == "\1\0\0\0\1"
			end, 50, base64EncodeSync(BASE64_TEST))
		end

		local HttpService = service.HttpService

		local function http_zstdcompress(input)
			if not base64decode then
				return nil
			end
			local ok, encoded = pcall(HttpService.JSONEncode, HttpService, buffer.fromstring(input))
			if not ok then
				return nil
			end
			local keyStart = string_find(encoded, '"zbase64"')
			if not keyStart then
				return nil
			end
			local valueStart = string_find(encoded, '"', keyStart + 9)
			if not valueStart then
				return nil
			end
			local valueEnd = string_find(encoded, '"', valueStart + 1)
			if not valueEnd then
				return nil
			end
			return base64decode(string.sub(encoded, valueStart + 1, valueEnd - 1))
		end

		local COMPRESS_TEST
		do
			local n = 4000
			local planes = table.create(4)
			for p = 1, 4 do
				local bytes = table.create(n)
				for i = 1, n do
					bytes[i] = p <= 2 and (i % 3) or ((i * 2654435761) % 256)
				end
				planes[p] = string.char(table.unpack(bytes, 1, math.min(n, 7997)))
			end
			COMPRESS_TEST = table.concat(planes)
		end

		if CompressionMode == "zstd" and not SetupCache.zstdPicked then
			SetupCache.zstdPicked = true
			zstdcompress = pickFastestBy({ zstdcompress, http_zstdcompress, es_zstdcompress }, function(f)
				local out = f(COMPRESS_TEST)
				return type(out) == "string" and #out > 4 and string.sub(out, 1, 4) == "\40\181\47\253"
			end, 10, COMPRESS_TEST)
		end

		if (CompressionMode == "zstd" or CompressionMode == "lz4") and not SetupCache.lz4Picked then
			SetupCache.lz4Picked = true
			local LZ4_PROBE = "\1\2\3\4\5\6\7\8"
			lz4compress = pickFastestBy({ lz4compress, lz4CompressString }, function(f)
				local out = f(LZ4_PROBE)
				return type(out) == "string" and #out == #LZ4_PROBE + 1 and string.byte(out, 1) == #LZ4_PROBE * 16 and string.sub(out, 2) == LZ4_PROBE
			end, 10, COMPRESS_TEST)
		end

		if CompressionMode == "zstd" and not zstdcompress then
			CompressionMode = lz4compress and "lz4" or false
		end
		if CompressionMode == "lz4" and not lz4compress then
			CompressionMode = false
		end
		if CompressionMode ~= "zstd" and CompressionMode ~= "lz4" then
			CompressionMode = false
		end
		compressionUsed = CompressionMode or "nenhuma"
	end

	if not ClassList then
		local ok, result = pcall(FetchAPI)
		if ok and result then
			ClassList = result
		else
			Abort("Falha ao carregar o API Dump: " .. tostring(result))
			return
		end
	end

	buildSourceClasses()

	if OPTIONS.IgnoreSpecialProperties and gethiddenproperty then
		old_gethiddenproperty = gethiddenproperty
		gethiddenproperty = nil
	end

	local crashedTypes = {}
	for datatype, state in GHPPersisted do
		if state == "crashed" then
			table.insert(crashedTypes, datatype)
		end
	end
	if #crashedTypes > 0 then
		table.sort(crashedTypes)
		warn("gethiddenproperty ignorado para tipos que travaram antes: " .. table.concat(crashedTypes, ", ") .. ". Use RetryCrashedGHP = true para tentar de novo.")
	end

	elapse_t = os.clock()

	local ok, err = xpcall(save_game, function(e)
		return debug.traceback(e)
	end)

	if OPTIONS.BoostFPS then
		pcall(function()
			local max = 5
			task.delay(math.clamp(max - (os.clock() - elapse_t), 0, max), pcall, service.GuiService.ClearError, service.GuiService)
			service.RunService:Set3dRenderingEnabled(true)
		end)
	end

	if old_gethiddenproperty then
		gethiddenproperty = old_gethiddenproperty
	end

	flushDiskCache()
	saveGHPState()

	if ok and writefile then
		pcall(function()
			local history = {}
			if isfile and readfile and isfile(STATS_HISTORY_FILE) then
				local okH, dataH = pcall(function()
					return service.HttpService:JSONDecode(readfile(STATS_HISTORY_FILE))
				end)
				if okH and type(dataH) == "table" then
					history = dataH
				end
			end
			local entry = {
				time = os.time(),
				placeId = game.PlaceId,
				file = placename,
				instances = Stats.instances,
				scripts = Stats.scripts,
				scriptsOk = Stats.scriptsOk,
				scriptsFailed = Stats.scriptsFailed,
				terrain = Stats.terrain,
				sweepPoints = Stats.sweepPoints,
				accumulated = Stats.accumulated,
				gcInstances = Stats.gcInstances,
				gcTables = Stats.gcTables,
				remotes = Stats.remotes,
				externalContent = Stats.externalContent,
				contentPasses = Stats.contentPasses,
				remoteLogLoaded = Stats.remoteLogLoaded,
				assetsDownloaded = Stats.assetsDownloaded,
				assetsFailed = Stats.assetsFailed,
				elapsed = elapse_t,
				size = totalsize,
			}
			history[#history + 1] = entry
			while #history > 20 do
				table.remove(history, 1)
			end
			writefile(STATS_HISTORY_FILE, service.HttpService:JSONEncode(history))
		end)
	end

	if ok and OPTIONS.CompletenessReport then
		warn(table.concat(completenessLines(), "\n"))
	end

	if ok and OPTIONS.Resume and delfile and isfile and isfile(CHECKPOINT_FILE) then
		pcall(delfile, CHECKPOINT_FILE)
	end

	Cleanup()

	elapse_t = os.clock() - elapse_t
	local Log10 = math.log10(math.max(elapse_t, 1))
	local ExtraTime = 10

	if not ok then
		warn("Erro ao salvar:")
		warn(err)
	end

	if StatusText then
		task.spawn(function()
			if ok then
				StatusText.Text = string.format("Salvo! Tempo %.3fs | Tamanho %s%s", elapse_t, get_size_format(), validationNote)
				StatusText.TextColor3 = Color3.new(0, 1)
				if ProgressFill then
					ProgressFill.Size = UDim2.new(1, 0, 1, 0)
					ProgressFill.BackgroundColor3 = Color3.new(0, 1, 0)
				end
				task.wait(Log10 * 2 + ExtraTime)
			else
				StatusText.Text = "Falhou! Verifique o console F9" .. validationNote
				StatusText.TextColor3 = Color3.new(1)
				if ProgressFill then
					ProgressFill.BackgroundColor3 = Color3.new(1, 0, 0)
				end
				task.wait(Log10 + ExtraTime)
			end
			StatusText:Destroy()
		end)
	end

	if OPTIONS.ShutdownWhenDone and ok then
		task.wait(Log10 * 2 + ExtraTime)
		game:Shutdown()
	end
end

return synsaveinstance
