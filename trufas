	local function startAccumulation()
		for _, root in ToSaveList do
			if typeof(root) == "Instance" and root ~= game then
				Connect(root.DescendantAdded, function(instance)
					Accum.lastAddedAt = os.clock()
					if Accum.tracking then
						trackBounds(instance)
					end
				end)
				if OPTIONS.Accumulate then
					Connect(root.DescendantRemoving, function(instance)
						if Accum.count >= OPTIONS.AccumulateLimit or Accum.gone[instance] then
							return
						end
						local parent = instance.Parent
						if not parent or not accumulatable(instance) then
							return
						end
						local okKids, kids = pcall(instance.GetChildren, instance)
						Accum.gone[instance] = { parent = parent, kids = okKids and #kids or 0 }
						Accum.count += 1
						Accum.order[Accum.count] = instance
					end)
				end
			end
		end
	end

	local function startRemoteLog()
		if not OPTIONS.RemoteLog then
			return
		end
		if not (hookmetamethod and getnamecallmethod) then
			warn("[USSI] RemoteLog indisponivel: hookmetamethod/getnamecallmethod ausentes")
			return
		end
		remoteLogActive = true
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", (newcclosure or function(f)
			return f
		end)(function(self, ...)
			local method = getnamecallmethod()
			if remoteLogActive and (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" and not (checkcaller and checkcaller()) then
				pcall(recordRemote, self, "out", method, ...)
			end
			if setnamecallmethod then
				setnamecallmethod(method)
			end
			return oldNamecall(self, ...)
		end))
		local function listen(remote)
			if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
				Connect(remote.OnClientEvent, function(...)
					if remoteLogActive then
						recordRemote(remote, "in", "OnClientEvent", ...)
					end
				end)
			elseif remote:IsA("BindableEvent") then
				Connect(remote.Event, function(...)
					if remoteLogActive then
						recordRemote(remote, "in", "Bindable.Fire", ...)
					end
				end)
			elseif remote:IsA("RemoteFunction") then
				pcall(recordRemote, remote, "meta", "RemoteFunction", nil)
			end
		end
		local function isLoggable(descendant)
			return descendant:IsA("RemoteEvent")
				or descendant:IsA("UnreliableRemoteEvent")
				or descendant:IsA("BindableEvent")
				or descendant:IsA("RemoteFunction")
		end
		for _, root in ToSaveList do
			if typeof(root) == "Instance" and root ~= game then
				for _, descendant in root:GetDescendants() do
					if isLoggable(descendant) then
						listen(descendant)
					end
				end
				Connect(root.DescendantAdded, function(descendant)
					if isLoggable(descendant) then
						listen(descendant)
					end
				end)
			end
		end
	end

