                local typeId=Attribute_Type_Ids["Path2DControlPoint"]
                local enc=Binary_Encoders["Path2DControlPoint"]
                local offset=4
                for _,pt in cps do
                    local pb,ps=enc(pt); buffer.writeu8(b,offset,typeId); offset+=1
                    buffer.copy(b,offset,pb); offset+=ps
