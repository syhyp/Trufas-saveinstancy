    local function get_eta_format()
        if total_count <= 0 or saved_count <= 0 then return "calculando..." end
        local elapsed = os.clock() - elapse_start
        local rate = saved_count / elapsed
        if rate <= 0 then return "calculando..." end
        local remaining = (total_count - saved_count) / rate
        if remaining > 3600 then
            return string.format("~%.1fh", remaining / 3600)
        elseif remaining > 60 then
            return string.format("~%.0fm %02ds", math.floor(remaining/60), remaining%60)
        else
            return string.format("~%.0fs", remaining)
        end
    end

