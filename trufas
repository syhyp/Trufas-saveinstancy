    local function AttributesSerialize(attrs, header_bytes)
        local count=0; local buffer_size=4; local sorted={}; local formatted=table.clone(attrs)
        if header_bytes then buffer_size+=#header_bytes end
        for attr,val in attrs do
            local t=resolveTypeName(val); local enc=Binary_Encoders[t]
            if not enc then continue end
            count+=1; sorted[count]=attr
            local as; formatted[attr],as=enc(val)
            buffer_size+=5+#attr+as
        end
        table.sort(sorted)
        local b=buffer.create(buffer_size); local offset=0
        if header_bytes then
            for _,hb in header_bytes do buffer.writeu8(b,offset,hb); offset+=1 end
        end
        buffer.writeu32(b,offset,count); offset+=4
        local se=Binary_Encoders["string"]
        for _,attr in sorted do
            local nb,ns=se(attr); buffer.copy(b,offset,nb); offset+=ns
            buffer.writeu8(b,offset,Attribute_Type_Ids[resolveTypeName(attrs[attr])]); offset+=1
            local bb=formatted[attr]; buffer.copy(b,offset,bb); offset+=buffer.len(bb)
        end
        return buffer.tostring(b)
    end

    local function AttenuationSerialize(att)
        if not next(att) then return "\0" end
        local count=0; local sorted={}
        for k in att do count+=1; sorted[count]=k end
        table.sort(sorted)
        local b=buffer.create(1+count*8); local offset=1
        for _,k in sorted do
            buffer.writef32(b,offset,k); offset+=4
            buffer.writef32(b,offset,att[k]); offset+=4
        end
        return buffer.tostring(b)
    end

    local function TransformsSerialize(transforms)
        local n=#transforms
        if n==0 then return "\1\0\0\0\0\0\0\0" end
        local b=buffer.create(8+n*48)
        buffer.writeu32(b,0,1); buffer.writeu32(b,4,n)
        local pF32=Binary_Encoders._packF32; local offset=8
        for _,t in transforms do
            local X,Y,Z,R00,R01,R02,R10,R11,R12,R20,R21,R22=t:GetComponents()
            buffer.copy(b,offset,pF32(R00,R01,R02)); offset+=12
            buffer.copy(b,offset,pF32(R10,R11,R12)); offset+=12
            buffer.copy(b,offset,pF32(R20,R21,R22)); offset+=12
            buffer.copy(b,offset,pF32(X,Y,Z)); offset+=12
        end
        return buffer.tostring(b)
    end

    local function ServiceVisibilitySerialize(wantVisible)
        local ESVS=game:GetService("ExplorerServiceVisibilityService")
        local se=Binary_Encoders["string"]; local typeId=Attribute_Type_Ids["string"]
        local count=0; local buffer_size=4; local names={}; local formatted={}
        for _,svc in game:GetChildren() do
            if ESVS:GetServiceVisibility(svc)==wantVisible then
                local name=svc.ClassName; local buf,size=se(name)
                count+=1; names[count]=name; formatted[name]=buf
                buffer_size+=1+size
            end
        end
        if count==0 then return "\0\0\0\0" end
        table.sort(names)
        local b=buffer.create(buffer_size); buffer.writeu32(b,0,count)
        local offset=4
        for _,name in names do
            buffer.writeu8(b,offset,typeId); offset+=1
            local bb=formatted[name]; buffer.copy(b,offset,bb); offset+=buffer.len(bb)
        end
        return buffer.tostring(b)
    end

    local function encodeTimeTicks(time)
        local scaled=time*2400
        if not (scaled>=-2147483648.0 and scaled<2147483648.0) then return -2147483648 end
        return math.round(scaled)
    end

    local function writeTimesSection(b,offset,keys)
        buffer.writeu32(b,offset,1); offset+=4
        buffer.writeu32(b,offset,#keys); offset+=4
        for _,k in keys do buffer.writei32(b,offset,encodeTimeTicks(k.Time)); offset+=4 end
        return offset
    end

    local function deriveTangentValueCurve(keys,i)
        local key=keys[i]
        if i==#keys then return 0,0 end
        if key.Interpolation==Enum.KeyInterpolationMode.Constant then return 0,0 end
        if key.Interpolation==Enum.KeyInterpolationMode.Linear then
            local nk=keys[i+1]; local t=1/(nk.Time-key.Time); return t,t
        end
        if i==1 then return 0,0 end
        local pk=keys[i-1]; local dp=key.Time-pk.Time
        if pk.Interpolation==Enum.KeyInterpolationMode.Constant then return 0,0
        elseif pk.Interpolation==Enum.KeyInterpolationMode.Linear then local t=1/dp; return t,t
        else
            local nk=keys[i+1]; local dn=nk.Time-key.Time
            local t=(1/dp+1/dn)/2; return t,t
        end
    end

    local function deriveTangentFloatCurve(keys,i)
        local key=keys[i]
        if i==#keys then return 0,0 end
        if key.Interpolation==Enum.KeyInterpolationMode.Constant then return 0,0 end
        if key.Interpolation==Enum.KeyInterpolationMode.Linear then
            local nk=keys[i+1]; local slope=(nk.Value-key.Value)/(nk.Time-key.Time); return slope,slope
        end
        if i==1 then return 0,0 end
        local pk=keys[i-1]
        if pk.Interpolation==Enum.KeyInterpolationMode.Constant then return 0,0
        elseif pk.Interpolation==Enum.KeyInterpolationMode.Linear then
            local slope=(key.Value-pk.Value)/(key.Time-pk.Time); return slope,slope
        else return 0,0 end
    end

    local NotScriptableFixes = {
        Instance = {
            AttributesSerialize = function(instance)
                local attrs=instance:GetAttributes()
