    FetchAPI = function()
        local FILE_NAME="API_DUMP.json"
        local API_Dump
        local Max_SC=SecurityCapabilities.new(unpack(Enum.SecurityCapability:GetEnumItems()))
        local filter={Security=Max_SC,ExcludeDisplay=true,ExcludeInherited=true}

        local APIDUMP_FETCHERS = {
            [1]=function()
