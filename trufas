		local decompRetry = makeTimeoutHandler(OPTIONS.DecompileTimeout < 0 and -1 or OPTIONS.DecompileTimeout * 2, decompile, DECOMPILE_TIMEOUT_MSG)
		ldecompile = function(script)
			local bytecode, hash
			if ScriptCache then
				local s
				s, bytecode = getbytecode(script)
				local cached
				if s then
					if not bytecode or bytecode == "" then
						return "-- O script esta vazio"
					end
					cached = ldeccache[bytecode]
				else
					bytecode = nil
				end
				if cached then
					return cached
				end
			end
			if diskCacheEnabled then
				hash = scriptHash(script, bytecode)
				local stored = hash and diskCache[hash]
				if stored then
					local now = os.time()
					if now - (stored.u or 0) > 86400 then
						stored.u = now
						diskCacheDirty = true
					end
					if bytecode then
						ldeccache[bytecode] = stored.o
					end
					return stored.o
				end
			end
			if DecompileJobless then
				return "-- Nao encontrado no ScriptCache ja decompilado"
			end
			local ok, result = run_with_loading("Decompilando " .. script.Name, true, nil, decomp, script)
			local attempt = 0
			while not ok and result == DECOMPILE_TIMEOUT_MSG and attempt < OPTIONS.DecompileRetries do
				attempt += 1
				ok, result = run_with_loading("Decompilando (retry) " .. script.Name, true, nil, decompRetry, script)
			end
			if not result then
				ok, result = false, "Saida vazia"
			end
			local output
			if ok then
				result = string.gsub(result, "\0", "\\0")
				output = result
			else
				output = DECOMPILE_FAIL_PREFIX .. ". Motivo:\n" .. tostring(result or "") .. "\n]]"
			end
			if ScriptCache and bytecode then
				ldeccache[bytecode] = output
			end
			if ok and hash then
				diskCache[hash] = { o = output, u = os.time(), v = FULL_VERSION, b = bytecode }
				diskCacheSize += #output
				diskCacheDirty = true
				if diskCacheSize > DISK_CACHE_LIMIT * 1.25 then
					evictDiskCache(0.8)
				end
				decompiledSinceFlush += 1
				if decompiledSinceFlush >= OPTIONS.CheckpointInterval then
					decompiledSinceFlush = 0
					flushDiskCache()
					writeCheckpoint(phase)
				end
			end
			return output
		end
	else
		ldecompile = function()
			return "-- Seu executor NAO possui decompiler"
		end
	end

