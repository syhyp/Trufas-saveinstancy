    local function gsubCI(input,search,replacement)
        local il=string.lower(input)
        search=string.lower(search)
        local sl=#search
        if sl==0 or not string_find(il,search) then return input end
        local ss={}
        local n=0
        local lf=0
        local inl=#input
        while lf+sl<=inl do
            local start,finish=string_find(il,search,lf+1)
            if not start then break end
            n+=1; ss[n]=string.sub(input,lf+1,start-1)
            n+=1; ss[n]=replacement
            lf=finish
        end
        n+=1; ss[n]=string.sub(input,lf+1)
        return table.concat(ss)
    end

    local function filterPropVal(result,pn,cat)
