		local GC_INSTANCE_CLASSES = {
			"PVInstance", "LayerCollector", "GuiObject", "Folder", "Configuration", "ValueBase",
			"LuaSourceContainer", "BackpackItem", "Accoutrement", "Sound", "Animation",
		}

		local function gcInstanceAllowed(instance)
			for _, className in GC_INSTANCE_CLASSES do
				if instance:IsA(className) then
					return true
				end
			end
			return false
		end

		local nilSeen = {}

		local function fixNilInstance(instance)
			if nilSeen[instance] then
				return nil
			end
			nilSeen[instance] = true
			if instance:IsA("ServiceProvider") then
				return nil
			end
			local ClassName = instance.ClassName
			local NilInstancesFixes = OPTIONS.NilInstancesFixes
			local Fix = NilInstancesFixes[ClassName]
			if Fix == nil then
				for class_name, inheritedFix in NilInstancesFixes do
					if instance:IsA(class_name) then
						Fix = inheritedFix
						break
					end
				end
			end
			if Fix then
				instance = Fix(instance, InstancesOverrides)
			end
			local Class = ClassList[ClassName]
			if Class and Class.Service then
				instance = nil
			end
			return instance
		end

		local function scanGC(dataChildren)
			if not (OPTIONS.ScanGC and getgc) then
				return
			end
			local okGC, objects = pcall(getgc, true)
			if not okGC or type(objects) ~= "table" then
				return
			end
			local instances, candidates = {}, {}
			for _, value in objects do
				local t = typeof(value)
				if t == "Instance" then
					pcall(function()
						if value.Parent == nil and gcInstanceAllowed(value) then
							local fixed = fixNilInstance(value)
							if fixed then
								instances[#instances + 1] = fixed
							end
						end
					end)
				elseif t == "table" then
					pcall(function()
						local count, strings, numbers, bools, nested, funcs = 0, 0, 0, 0, 0, 0
						for key, item in next, value do
							count += 1
							if count > 800 then
								return
							end
							local tk, ti = type(key), type(item)
							if tk == "string" then strings += 1 end
							if ti == "string" then strings += 1 end
							if ti == "number" then numbers += 1 end
							if ti == "boolean" then bools += 1 end
							if ti == "table" then nested += 1 end
							if ti == "function" then funcs += 1 end
						end
						if funcs > count * 0.3 then
							return
						end
						local score = strings + numbers + bools + nested * 2
						if score >= 6 then
							candidates[#candidates + 1] = { value = value, score = score }
						end
					end)
				end
			end
			local extraNil = {}
			for _, value in objects do
				if typeof(value) == "Instance" then
					pcall(function()
						if not nilSeen[value] then
							local okDesc, desc = pcall(function() return value:IsDescendantOf(game) end)
							if okDesc and not desc and gcInstanceAllowed(value) then
								local fixed = fixNilInstance(value)
								if fixed then
									extraNil[#extraNil + 1] = fixed
								end
							end
						end
					end)
				end
			end
			for _, inst in extraNil do
				instances[#instances + 1] = inst
			end
			if #instances > 0 then
				Stats.gcInstances = #instances
				register_extra("GC Instances", instances)
			end
			table.sort(candidates, function(a, b)
				return a.score > b.score
			end)
			local modules, seenSources = {}, {}
			for _, candidate in candidates do
				if #modules >= OPTIONS.GCTableLimit then
					break
				end
				local okLiteral, literal = pcall(luaLiteral, candidate.value)
				if okLiteral and not seenSources[literal] then
					seenSources[literal] = true
					modules[#modules + 1] = makeVirtual("ModuleScript", string.format("Table_%03d", #modules + 1), { Source = "return " .. literal }, true)
				end
			end
			if #modules > 0 then
				Stats.gcTables = #modules
				local folder = makeVirtual("Folder", "GC Tables", {}, true)
				InstancesOverrides[folder].__Children = modules
				dataChildren[#dataChildren + 1] = folder
			end
		end

		local function terrainSlotsSource()
			local terrain = workspace:FindFirstChildOfClass("Terrain")
			if not terrain then
				return nil
			end
			local data = {}
			for _, material in Enum.Material:GetEnumItems() do
				local entry = {}
				local okColor, color = pcall(terrain.GetMaterialColor, terrain, material)
				if okColor and typeof(color) == "Color3" then
					entry.Color = color
				end
				local okSlot, slot = pcall(function()
					return terrain:GetMaterialSlot(material)
				end)
				if okSlot and slot ~= nil then
					entry.Slot = typeof(slot) == "Instance" and slot.Name or slot
				end
				if next(entry) then
					data[material.Name] = entry
				end
			end
			if not next(data) then
				return nil
			end
			return "return " .. luaLiteral(data)
		end

