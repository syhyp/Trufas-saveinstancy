	local function save_game()
		local function accumKey(instance)
			local ok, key = pcall(function()
				local k = instance.ClassName .. "|" .. instance.Name
				if instance:IsA("PVInstance") then
					local p = instance:GetPivot().Position
					k ..= string.format("|%.1f,%.1f,%.1f", p.X, p.Y, p.Z)
				end
				return k
			end)
			return ok and key or tostring(instance)
		end

		local function applyAccumulated()
			if not OPTIONS.Accumulate or Accum.count == 0 then
				return
			end
			local eligible = {}
			for _, instance in Accum.order do
				local info = Accum.gone[instance]
				if info and instance.Parent == nil then
					local destroyed = false
					if not OPTIONS.AccumulateDestroyed then
						if not pcall(function()
							instance.Parent = nil
						end) then
							destroyed = true
						elseif info.kids > 0 and #instance:GetChildren() == 0 then
							destroyed = true
						end
					end
					if not destroyed then
						eligible[instance] = info
					end
				end
			end
			local placed, groups, parentOrder = {}, {}, {}
			for _ = 1, 3 do
				local changed = false
				for _, instance in Accum.order do
					local info = eligible[instance]
					if info and not placed[instance] then
						local parent = info.parent
						local ok, inTree = pcall(function()
							return parent == game or parent:IsDescendantOf(game)
						end)
						if (ok and inTree) or placed[parent] then
							placed[instance] = true
							changed = true
							local group = groups[parent]
							if not group then
								group = {}
								groups[parent] = group
								parentOrder[#parentOrder + 1] = parent
							end
							group[#group + 1] = instance
						end
					end
				end
				if not changed then
					break
				end
			end
			for _, parent in parentOrder do
				local override = InstancesOverrides[parent]
				local children
				if override and override.__Children then
					children = table.clone(override.__Children)
				else
					children = parent:GetChildren()
				end
				local keys = {}
				for _, child in children do
					keys[accumKey(child)] = true
				end
				local added = 0
				for _, instance in groups[parent] do
					local key = accumKey(instance)
					if not keys[key] then
						keys[key] = true
						children[#children + 1] = instance
						added += 1
					end
				end
				if added > 0 then
					if override then
						override.__Children = children
					else
						InstancesOverrides[parent] = { __Children = children }
					end
					Stats.accumulated += added
				end
			end
		end

		local function remoteLogSource()
			if next(RemoteLogData) == nil then
				return "return {}"
			end
			local paths = {}
			for path in RemoteLogData do
				paths[#paths + 1] = path
			end
			table.sort(paths)
			local lines = { "-- Remotes observados durante a sessao (interface cliente <-> servidor)", "return {" }
			for _, path in paths do
				local entry = RemoteLogData[path]
				lines[#lines + 1] = "\t[" .. string.format("%q", path) .. "] = {"
				lines[#lines + 1] = "\t\tClass = " .. string.format("%q", entry.Class) .. ","
				for _, direction in { "Out", "In" } do
					local records = {}
					for _, record in entry[direction] do
						records[#records + 1] = record
					end
					table.sort(records, function(a, b)
						return a.Signature < b.Signature
					end)
					if #records > 0 then
						lines[#lines + 1] = "\t\t" .. direction .. " = {"
						for _, record in records do
							lines[#lines + 1] = string.format(
								"\t\t\t{ Call = %q, Signature = %q, Count = %d, Sample = %q },",
								record.Method .. "(" .. record.Signature .. ")",
								record.Signature,
								record.Count,
								record.Sample
							)
						end
						lines[#lines + 1] = "\t\t},"
					end
				end
				lines[#lines + 1] = "\t},"
			end
			lines[#lines + 1] = "}"
			return table.concat(lines, "\n")
		end

