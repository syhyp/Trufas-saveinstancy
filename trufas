    end,
    ["NumberSequence"] = nil,
    ["NumberSequenceKeypoint"] = function(kp, b, offset)
        if not b then return Binary_Encoders._packF32(kp.Envelope,kp.Time,kp.Value) end
        buffer.writef32(b,offset,kp.Envelope); offset+=4
        buffer.writef32(b,offset,kp.Time); offset+=4
